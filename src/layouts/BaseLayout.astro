---
import "../styles/global.css";
import "../styles/luxury.css";
import "../styles/reference.css";
import "../styles/minimal-luxury.css";
import CartDrawer from "../components/CartDrawer.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  keywords: string[];
  pageType?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  keywords,
  pageType = "website",
  noindex = false
} = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(canonicalPath, siteUrl);
const socialImage = new URL("/images/orenza-leopard-label.png", siteUrl);
const fullTitle = `${title} | اورنزا`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "Orenza Coffee",
      alternateName: "قهوه اورنزا",
      url: siteUrl.toString(),
      logo: socialImage.toString(),
      email: "order.orenzacoffee@gmail.com",
      telephone: "+989103060396",
      contactPoint: {
        "@type": "ContactPoint",
        telephone: "+989103060396",
        contactType: "customer service",
        availableLanguage: ["fa"]
      },
      sameAs: ["https://instagram.com/orenzacoffee", "https://ble.ir/khoobrooz"]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      name: "قهوه اورنزا",
      alternateName: "Orenza Coffee",
      url: siteUrl.toString(),
      inLanguage: "fa-IR",
      publisher: { "@id": `${siteUrl}#organization` }
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      name: fullTitle,
      description,
      url: canonical.toString(),
      inLanguage: "fa-IR",
      isPartOf: { "@id": `${siteUrl}#website` },
      about: { "@id": `${siteUrl}#organization` }
    }
  ]
};
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0b0b0a" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(", ")} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="author" content="Orenza Coffee" />
    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:site_name" content="Orenza Coffee" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={socialImage.toString()} />
    <meta property="og:image:alt" content="نشان تصویری پلنگ ایرانی اورنزا" />
    <meta property="og:image:width" content="620" />
    <meta property="og:image:height" content="895" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.toString()} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="alternate" hreflang="fa-IR" href={canonical.toString()} />
    <link rel="alternate" hreflang="x-default" href={canonical.toString()} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noindex && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}></script>}
    <title>{fullTitle}</title>
  </head>
  <body>
    <Header />
    <main id="top"><slot /></main>
    <Footer />
    <CartDrawer />
    <script>
      import "../scripts/configurator.ts";
    </script>
  </body>
</html>
