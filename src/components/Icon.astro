---
import {
  ArrowLeft,
  Bean,
  Camera,
  Contact,
  LayoutDashboard,
  LockKeyhole,
  LogOut,
  Gauge,
  Mail,
  MapPin,
  MessageCircle,
  MessageCircleCheck,
  Phone,
  Send,
  ShoppingBag,
  UserRound,
  X
} from "@lucide/astro";

type IconName =
  | "instagram"
  | "whatsapp"
  | "bale"
  | "phone"
  | "email"
  | "arrow"
  | "cart"
  | "send"
  | "user"
  | "dashboard"
  | "profile"
  | "address"
  | "security"
  | "logout"
  | "bean"
  | "grind"
  | "close";

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 20 } = Astro.props;
const icons = {
  instagram: Camera,
  whatsapp: MessageCircle,
  bale: MessageCircleCheck,
  phone: Phone,
  email: Mail,
  arrow: ArrowLeft,
  cart: ShoppingBag,
  send: Send,
  user: UserRound,
  dashboard: LayoutDashboard,
  profile: Contact,
  address: MapPin,
  security: LockKeyhole,
  logout: LogOut,
  bean: Bean,
  grind: Gauge,
  close: X
} satisfies Record<IconName, typeof ArrowLeft>;
const LucideIcon = icons[name];
---

<LucideIcon
  class={`icon icon-${name}`}
  width={size}
  height={size}
  stroke-width={1.45}
  aria-hidden="true"
/>
