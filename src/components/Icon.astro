---
import {
  ArrowLeft,
  Bean,
  Coffee,
  Contact,
  LayoutDashboard,
  LockKeyhole,
  LogOut,
  Gauge,
  Grid2X2,
  Home,
  Mail,
  MapPin,
  MessageCircle,
  MessageCircleCheck,
  Phone,
  Send,
  ShoppingBag,
  Store,
  Search,
  Bell,
  UserRound,
  X
} from "@lucide/astro";

type IconName =
  | "instagram"
  | "whatsapp"
  | "bale"
  | "phone"
  | "email"
  | "arrow"
  | "cart"
  | "send"
  | "user"
  | "dashboard"
  | "profile"
  | "address"
  | "security"
  | "logout"
  | "bean"
  | "grind"
  | "close"
  | "home"
  | "grid"
  | "search"
  | "bell"
  | "coffee"
  | "store";

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 20 } = Astro.props;
const isInstagram = name === "instagram";
const icons = {
  whatsapp: MessageCircle,
  bale: MessageCircleCheck,
  phone: Phone,
  email: Mail,
  arrow: ArrowLeft,
  cart: ShoppingBag,
  send: Send,
  user: UserRound,
  dashboard: LayoutDashboard,
  profile: Contact,
  address: MapPin,
  security: LockKeyhole,
  logout: LogOut,
  bean: Bean,
  grind: Gauge,
  close: X,
  home: Home,
  grid: Grid2X2,
  search: Search,
  bell: Bell,
  coffee: Coffee,
  store: Store
} satisfies Record<Exclude<IconName, "instagram">, typeof ArrowLeft>;
const LucideIcon = icons[name as keyof typeof icons] ?? MessageCircle;
---

{
  isInstagram ? (
    <svg class="icon icon-instagram" width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="4.2" y="4.2" width="15.6" height="15.6" rx="4.2" stroke="currentColor" stroke-width="1.45" />
      <circle cx="12" cy="12" r="3.55" stroke="currentColor" stroke-width="1.45" />
      <circle cx="16.65" cy="7.35" r="1" fill="currentColor" />
    </svg>
  ) : (
    <LucideIcon
      class={`icon icon-${name}`}
      width={size}
      height={size}
      stroke-width={1.45}
      aria-hidden="true"
    />
  )
}
