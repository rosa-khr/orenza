---
import { Download, Share, SquarePlus, X } from "@lucide/astro";
---

<section class="ios-install" data-ios-install aria-labelledby="ios-install-title">
  <div class="ios-install__inner">
    <img src="/ios-icon.png" width="42" height="42" alt="آیکون iOS" loading="lazy" />
    <div class="ios-install__copy">
      <h2 id="ios-install-title">اپلیکیشن اورنزا</h2>
      <p>دسترسی سریع‌تر به فروشگاه از صفحه اصلی موبایل</p>
    </div>
    <button class="ios-install__button" type="button" data-ios-install-open>
      <Download size={16} stroke-width={1.6} aria-hidden="true" />
      <span>راهنمای نصب iOS</span>
    </button>
  </div>
</section>

<div class="ios-install-modal" data-ios-install-modal hidden>
  <button class="ios-install-modal__backdrop" type="button" data-ios-install-close aria-label="بستن راهنمای نصب"></button>
  <section class="ios-install-modal__sheet" role="dialog" aria-modal="true" aria-labelledby="ios-install-modal-title" tabindex="-1">
    <header>
      <img src="/ios-icon.png" width="48" height="48" alt="" />
      <div>
        <small>نصب در کمتر از یک دقیقه</small>
        <h2 id="ios-install-modal-title">افزودن اورنزا به Home Screen</h2>
      </div>
      <button type="button" data-ios-install-close aria-label="بستن"><X size={19} aria-hidden="true" /></button>
    </header>
    <ol>
      <li><b>۱</b><div><strong>این صفحه را در Safari باز کنید</strong><span>نصب مستقیم وب‌اپ در مرورگر Safari انجام می‌شود.</span></div></li>
      <li><b>۲</b><div><strong>دکمه Share را بزنید</strong><span>آیکون مربع و فلش رو به بالا را در نوار Safari انتخاب کنید.</span></div><Share size={22} aria-hidden="true" /></li>
      <li><b>۳</b><div><strong>Add to Home Screen را انتخاب کنید</strong><span>اگر دیده نمی‌شود، فهرست گزینه‌ها را کمی به پایین اسکرول کنید.</span></div><SquarePlus size={22} aria-hidden="true" /></li>
      <li><b>۴</b><div><strong>در پایان Add را بزنید</strong><span>آیکون اورنزا روی صفحه اصلی دستگاه شما قرار می‌گیرد.</span></div></li>
    </ol>
    <p class="ios-install-modal__note" data-ios-install-note>پس از نصب، اورنزا تمام‌صفحه و مانند یک اپلیکیشن مستقل باز می‌شود.</p>
    <button class="ios-install-modal__done" type="button" data-ios-install-close>متوجه شدم</button>
  </section>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-ios-install]");
    const modal = document.querySelector("[data-ios-install-modal]");
    const sheet = modal?.querySelector(".ios-install-modal__sheet");
    if (modal && modal.parentElement !== document.body) document.body.append(modal);
    const isStandalone = window.matchMedia("(display-mode: standalone)").matches || window.navigator.standalone === true;
    if (isStandalone) {
      root?.setAttribute("hidden", "");
      return;
    }
    const open = () => {
      if (!modal) return;
      modal.hidden = false;
      document.body.classList.add("install-guide-is-open");
      requestAnimationFrame(() => {
        modal.classList.add("is-open");
        sheet?.focus();
      });
    };
    const close = () => {
      if (!modal) return;
      modal.classList.remove("is-open");
      document.body.classList.remove("install-guide-is-open");
      window.setTimeout(() => { modal.hidden = true; }, 240);
    };
    root?.querySelector("[data-ios-install-open]")?.addEventListener("click", open);
    modal?.querySelectorAll("[data-ios-install-close]").forEach((button) => button.addEventListener("click", close));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && modal && !modal.hidden) close();
    });
  })();
</script>

<style>
  .ios-install { position: relative; z-index: 4; color: #2c211a; }
  .ios-install[hidden] { display: none; }
  .ios-install__inner { display: flex; width: calc(100% - 128px); max-width: 1680px; min-height: 78px; align-items: center; justify-content: center; gap: 18px; margin: auto; border-bottom: 1px solid rgba(91,68,50,.13); padding: 17px 0; text-align: center; }
  .ios-install__inner > img { display: block; width: 42px; height: 42px; object-fit: contain; opacity: .9; }
  .ios-install__copy { display: grid; justify-items: center; }
  .ios-install__copy h2 { margin: 0 0 2px; color: #2c211a; font-size: 14px; font-weight: 700; }
  .ios-install__copy p { margin: 0; color: #756b63; font-size: 10px; line-height: 1.8; }
  .ios-install__button { display: inline-flex; min-height: 36px; align-items: center; gap: 7px; border: 1px solid rgba(75,47,32,.38); border-radius: 9px; background: transparent; padding: 7px 13px; color: #4b2f20; cursor: pointer; font: 700 10px Dana,Tahoma,sans-serif; transition: border-color 180ms ease, background-color 180ms ease; }
  .ios-install__button:hover { border-color: rgba(75,47,32,.7); background: rgba(75,47,32,.05); }
  .ios-install-modal { position: fixed; z-index: 20000; inset: 0; display: grid; place-items: center; padding: 18px; opacity: 0; isolation: isolate; transition: opacity 240ms ease; }
  .ios-install-modal[hidden] { display: none; }
  .ios-install-modal.is-open { opacity: 1; }
  .ios-install-modal__backdrop { position: absolute; inset: 0; border: 0; background: rgba(10,20,16,.64); backdrop-filter: blur(8px); cursor: pointer; }
  .ios-install-modal__sheet { position: relative; width: min(100%, 510px); max-height: calc(100dvh - 36px); overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; border: 1px solid rgba(166,120,56,.22); border-radius: 25px; background: #fff; padding: 24px; box-shadow: 0 28px 80px rgba(8,24,18,.28); outline: none; transform: translateY(18px) scale(.98); transition: transform 240ms ease; scrollbar-width: thin; }
  .ios-install-modal.is-open .ios-install-modal__sheet { transform: translateY(0) scale(1); }
  .ios-install-modal__sheet > header { display: grid; grid-template-columns: 48px minmax(0,1fr) 36px; align-items: center; gap: 13px; }
  .ios-install-modal__sheet > header img { width: 48px; height: 48px; object-fit: contain; }
  .ios-install-modal__sheet > header small { color: #9a692f; font-size: 9px; }
  .ios-install-modal__sheet > header h2 { margin: 4px 0 0; color: #1d382d; font-size: 19px; }
  .ios-install-modal__sheet > header button { display: grid; width: 36px; height: 36px; place-items: center; border: 1px solid #dde5e0; border-radius: 12px; background: #f7faf8; color: #26493a; cursor: pointer; }
  .ios-install-modal ol { display: grid; gap: 8px; margin: 20px 0 15px; padding: 0; list-style: none; }
  .ios-install-modal li { display: grid; min-height: 66px; grid-template-columns: 31px minmax(0,1fr) auto; align-items: center; gap: 11px; border: 1px solid #e6e4de; border-radius: 15px; padding: 10px 12px; }
  .ios-install-modal li > b { display: grid; width: 29px; height: 29px; place-items: center; border-radius: 50%; background: #edf4f0; color: #24503d; font-size: 11px; }
  .ios-install-modal li > div { display: grid; gap: 3px; }
  .ios-install-modal li strong { color: #292d29; font-size: 11px; }
  .ios-install-modal li span { color: #756e64; font-size: 9px; line-height: 1.7; }
  .ios-install-modal li > svg { color: #a56f2e; }
  .ios-install-modal__note { margin: 0 0 14px; color: #6b645b; font-size: 9px; line-height: 1.8; text-align: center; }
  .ios-install-modal__done { width: 100%; min-height: 42px; border: 0; border-radius: 12px; background: #244b3b; color: #fff; cursor: pointer; font: 700 11px Dana,Tahoma,sans-serif; }
  body.install-guide-is-open { overflow: hidden; }
  @media (max-width: 699px) {
    .ios-install__inner { width: calc(100% - 40px); min-height: 0; flex-direction: column; gap: 9px; padding: 18px 0; }
    .ios-install__inner > img { width: 40px; height: 40px; }
    .ios-install__copy h2 { font-size: 12px; }
    .ios-install__copy p { font-size: 8px; line-height: 1.7; }
    .ios-install__button { width: min(100%, 220px); min-height: 36px; justify-content: center; }
    .ios-install-modal { align-items: center; padding: max(10px, env(safe-area-inset-top)) 10px max(10px, env(safe-area-inset-bottom)); }
    .ios-install-modal__sheet { max-height: calc(100dvh - max(20px, env(safe-area-inset-top) + env(safe-area-inset-bottom))); overflow-y: auto; border-radius: 22px; padding: 15px; transform: translateY(18px); }
    .ios-install-modal__sheet > header { grid-template-columns: 40px minmax(0,1fr) 32px; gap: 9px; }
    .ios-install-modal__sheet > header img { width: 40px; height: 40px; }
    .ios-install-modal__sheet > header h2 { margin-top: 2px; font-size: 14px; }
    .ios-install-modal__sheet > header small { font-size: 7px; }
    .ios-install-modal__sheet > header button { width: 32px; height: 32px; border-radius: 10px; }
    .ios-install-modal ol { gap: 6px; margin: 14px 0 10px; }
    .ios-install-modal li { min-height: 57px; grid-template-columns: 27px minmax(0,1fr) auto; gap: 8px; border-radius: 12px; padding: 8px 10px; }
    .ios-install-modal li > b { width: 26px; height: 26px; font-size: 9px; }
    .ios-install-modal li strong { font-size: 9px; }
    .ios-install-modal li span { font-size: 7px; line-height: 1.55; }
    .ios-install-modal li > svg { width: 18px; height: 18px; }
    .ios-install-modal__note { margin-bottom: 9px; font-size: 7px; }
    .ios-install-modal__done { position: sticky; bottom: 0; min-height: 38px; box-shadow: 0 -7px 16px rgba(255,255,255,.94); }
    :global(body.install-guide-is-open .mobile-bottom-nav),
    :global(body.install-guide-is-open .support-chat),
    :global(body.install-guide-is-open .mobile-quick-links) { visibility: hidden; opacity: 0; pointer-events: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ios-install-modal,
    .ios-install-modal__sheet { transition: none; }
  }
</style>
