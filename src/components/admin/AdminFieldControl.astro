---
import {
  Bold, ChevronDown, Columns3, ImagePlus, Italic, Link2, List, ListOrdered,
  Quote, Redo2, RemoveFormatting, Rows3, Table2, TextAlignCenter,
  TextAlignEnd, TextAlignStart, Trash2, Underline, Undo2, Unlink2
} from "@lucide/astro";
import type { AdminField } from "../../admin/resources";

interface Props {
  field: AdminField;
  resourceKey: string;
  isView: boolean;
}

const { field, resourceKey, isView } = Astro.props;
const orderReadonly = new Set([
  "orderNumber", "customerName", "customerPhone", "customerAddress", "totalAmount",
  "discountAmount", "finalAmount", "customerNote"
]);
const moneyFieldKeys = new Set([
  "purchasePricePerKg", "salePricePerKg", "profitPerKg", "discountSalePricePerKg",
  "totalAmount", "discountAmount", "taxAmount", "finalAmount",
  "pricePerKg", "pricePerVolume", "minOrderAmount"
]);
const seoLimitFor = (key: string, fallback?: number) =>
  key === "seoTitle" ? 60 : key === "seoDescription" ? 150 : fallback;
const isReadonly = isView || field.readonly || (resourceKey === "orders" && orderReadonly.has(field.key));
const isBooleanSelect = field.type === "select" &&
  field.options?.length === 2 &&
  field.options.every((option) => option.value === "true" || option.value === "false");
const trueLabel = field.options?.find((option) => option.value === "true")?.label || "فعال";
const falseLabel = field.options?.find((option) => option.value === "false")?.label || "غیرفعال";
const isCalculatedSubmitField = field.key === "discountSalePricePerKg";
const booleanDefaultValue = field.key === "stockStatus"
  ? "inStock"
  : field.key === "robotsIndex" || field.key === "robotsFollow"
    ? "true"
    : "false";
const fieldHelp = field.key === "canonicalUrl"
  ? "آدرس اصلی و ترجیحی این صفحه برای موتورهای جست‌وجو؛ اگر خالی بماند، آدرس فعلی صفحه خودکار استفاده می‌شود."
  : "";
---

{field.type === "permissions" ? (
  <fieldset class="admin-permission-field admin-field wide" data-admin-field={field.key} disabled={isView}>
    <legend>{field.label}{field.required && !isView ? <i>*</i> : null}</legend>
    <div>
      {field.options?.map((option) => (
        <label>
          <input type="checkbox" name={field.key} value={option.value} />
          <span>{option.label}</span>
        </label>
      ))}
    </div>
    <small data-field-error={field.key}></small>
  </fieldset>
) : field.type === "richtext" ? (
  <div class="admin-field wide" data-admin-field={field.key}>
    <span>{field.label}{field.required && !isView ? <i>*</i> : null}</span>
    <div class="admin-rich-text" data-rich-text>
      <div class:list={["admin-rich-text-toolbar", { "is-readonly": isView }]} role="toolbar" aria-label={`ابزارهای ویرایش ${field.label}`}>
        <div class="admin-editor-tool-group">
          <button type="button" data-rich-command="undo" disabled={isView} title="واگرد" aria-label="واگرد"><Undo2 /></button>
          <button type="button" data-rich-command="redo" disabled={isView} title="از نو" aria-label="از نو"><Redo2 /></button>
        </div>
        <div class="admin-editor-tool-group admin-editor-format">
          <select data-rich-format disabled={isView} aria-label="نوع متن" title="نوع متن">
            <option value="p">Paragraph</option>
            <option value="h2">Heading 2</option>
            <option value="h3">Heading 3</option>
            <option value="blockquote">Blockquote</option>
          </select>
          <ChevronDown aria-hidden="true" />
        </div>
        <div class="admin-editor-tool-group">
          <button type="button" data-rich-command="bold" disabled={isView} title="ضخیم" aria-label="ضخیم"><Bold /></button>
          <button type="button" data-rich-command="italic" disabled={isView} title="مورب" aria-label="مورب"><Italic /></button>
          <button type="button" data-rich-command="underline" disabled={isView} title="زیرخط" aria-label="زیرخط"><Underline /></button>
        </div>
        <div class="admin-editor-tool-group">
          <button type="button" data-rich-command="insertUnorderedList" disabled={isView} title="فهرست نقطه‌ای" aria-label="فهرست نقطه‌ای"><List /></button>
          <button type="button" data-rich-command="insertOrderedList" disabled={isView} title="فهرست شماره‌ای" aria-label="فهرست شماره‌ای"><ListOrdered /></button>
          <button type="button" data-rich-command="formatBlock" data-rich-value="blockquote" disabled={isView} title="نقل‌قول" aria-label="نقل‌قول"><Quote /></button>
        </div>
        <div class="admin-editor-tool-group">
          <button type="button" data-rich-command="justifyRight" disabled={isView} title="راست‌چین" aria-label="راست‌چین"><TextAlignEnd /></button>
          <button type="button" data-rich-command="justifyCenter" disabled={isView} title="وسط‌چین" aria-label="وسط‌چین"><TextAlignCenter /></button>
          <button type="button" data-rich-command="justifyLeft" disabled={isView} title="چپ‌چین" aria-label="چپ‌چین"><TextAlignStart /></button>
        </div>
        <div class="admin-editor-tool-group">
          <button type="button" data-rich-command="createLink" disabled={isView} title="افزودن لینک" aria-label="افزودن لینک"><Link2 /></button>
          <button type="button" data-rich-command="unlink" disabled={isView} title="حذف لینک" aria-label="حذف لینک"><Unlink2 /></button>
          <button type="button" data-rich-insert-image disabled={isView} title="افزودن تصویر" aria-label="افزودن تصویر"><ImagePlus /></button>
        </div>
        <details class="admin-editor-table-menu">
          <summary title="ابزارهای جدول" aria-label="ابزارهای جدول"><Table2 /><ChevronDown /></summary>
          <div>
            <button type="button" data-rich-insert-table disabled={isView}><Table2 /> درج جدول</button>
            <button type="button" data-rich-table-command="addRowAfter" disabled><Rows3 /> افزودن ردیف</button>
            <button type="button" data-rich-table-command="addColumnAfter" disabled><Columns3 /> افزودن ستون</button>
            <button type="button" data-rich-table-command="deleteRow" disabled><Rows3 /> حذف ردیف</button>
            <button type="button" data-rich-table-command="deleteColumn" disabled><Columns3 /> حذف ستون</button>
            <button class="is-danger" type="button" data-rich-table-command="deleteTable" disabled><Trash2 /> حذف جدول</button>
          </div>
        </details>
        <div class="admin-editor-tool-group">
          <button type="button" data-rich-command="removeFormat" disabled={isView} title="پاک‌کردن قالب‌بندی" aria-label="پاک‌کردن قالب‌بندی"><RemoveFormatting /></button>
        </div>
        <input type="file" accept="image/jpeg,image/png,image/webp" data-rich-image-input hidden />
      </div>
      <div
        class="admin-rich-text-editor"
        contenteditable={isView ? "false" : "true"}
        role="textbox"
        aria-multiline="true"
        data-rich-text-editor={field.key}
        data-placeholder="متن فارسی را اینجا بنویسید…"
      ></div>
      {!isView && <p class="admin-editor-help">متن را مستقیماً Paste کنید؛ تصویر و جدول را از ابزارهای بالای ادیتور اضافه کنید.</p>}
      <textarea
        class="admin-rich-text-input"
        name={field.key}
        required={field.required}
        disabled={isView}
        data-rich-text-input={field.key}
        tabindex="-1"
        aria-hidden="true"
      ></textarea>
    </div>
    <small data-field-error={field.key}></small>
  </div>
) : field.type === "image-gallery" ? (
  <input type="hidden" name={field.key} value="[]" data-product-gallery-value />
) : isBooleanSelect || field.key === "stockStatus" ? (
  <label class="admin-field admin-boolean-field" data-admin-field={field.key} data-boolean-switch-field>
    <span>{field.label}{field.required && !isView ? <i>*</i> : null}</span>
    <input
      type="hidden"
      name={field.key}
      value={booleanDefaultValue}
      disabled={isReadonly}
      data-boolean-switch-value
      data-true-value={field.key === "stockStatus" ? "inStock" : "true"}
      data-false-value={field.key === "stockStatus" ? "outOfStock" : "false"}
      data-true-label={field.key === "stockStatus" ? "موجود" : trueLabel}
      data-false-label={field.key === "stockStatus" ? "ناموجود" : falseLabel}
    />
    <button type="button" class="admin-switch admin-boolean-switch" disabled={isReadonly} data-boolean-switch-button aria-pressed="false">
      <span></span>
      <b data-boolean-switch-label>{falseLabel}</b>
    </button>
    <small data-field-error={field.key}></small>
    {fieldHelp && <em class="admin-field-help">{fieldHelp}</em>}
  </label>
) : (
  <label class:list={["admin-field", { wide: field.type === "textarea" || field.type === "multiselect" }]} data-admin-field={field.key}>
    <span>{field.label}{field.required && !isView ? <i>*</i> : null}</span>
    {field.type === "textarea" ? (
      <textarea
        name={field.key}
        required={field.required}
        disabled={isView || (resourceKey === "orders" && orderReadonly.has(field.key))}
        minlength={field.required ? 2 : undefined}
        maxlength={seoLimitFor(field.key, field.maxLength)}
        data-seo-counter-limit={seoLimitFor(field.key)}
      ></textarea>
    ) : field.type === "multiselect" ? (
      <>
        <input type="text" data-tagify-field={field.key} disabled={isView} placeholder="برای جستجو و انتخاب کلیک کنید…" />
        <select class="admin-tagify-source" name={field.key} multiple size="7" disabled={isView} data-dynamic-options={field.key} aria-hidden="true" tabindex="-1"></select>
        <em class="admin-field-help">فقط موارد موجود در فهرست قابل انتخاب هستند و امکان ثبت مقدار جدید وجود ندارد.</em>
      </>
    ) : field.type === "select" ? (
      <select name={field.key} required={field.required} disabled={isReadonly} data-dynamic-options={!field.options ? field.key : undefined}>
        <option value="">انتخاب کنید</option>
        {field.options?.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
    ) : (
      <input
        name={field.key}
        type={field.type === "image" || moneyFieldKeys.has(field.key) ? "text" : field.type}
        required={field.required}
        disabled={isCalculatedSubmitField ? isView : isReadonly}
        readonly={isCalculatedSubmitField || field.readonly}
        min={field.min}
        maxlength={seoLimitFor(field.key, field.maxLength)}
        inputmode={moneyFieldKeys.has(field.key) ? "numeric" : undefined}
        data-money-input={moneyFieldKeys.has(field.key) ? "true" : undefined}
        data-seo-counter-limit={seoLimitFor(field.key)}
        dir={moneyFieldKeys.has(field.key) ? "ltr" : field.dir}
      />
    )}
    {fieldHelp && <em class="admin-field-help">{fieldHelp}</em>}
    {seoLimitFor(field.key) && <em class="admin-seo-counter" data-seo-counter={field.key}></em>}
    <small data-field-error={field.key}></small>
  </label>
)}
