---
import {
  BadgePercent,
  BookOpenText,
  Boxes,
  CreditCard,
  LayoutDashboard,
  LogOut,
  Menu,
  PackageCheck,
  ShieldCheck,
  Settings,
  UserRound,
  ChevronDown,
  Users,
  Tags,
  X
} from "@lucide/astro";
import { adminResources } from "../../admin/resources";
import "../../styles/admin.css";

interface Props {
  title: string;
  description?: string;
  active?: string;
  actionLabel?: string;
}

const { title, description = "", active = "dashboard", actionLabel } = Astro.props;
const icons = {
  users: Users,
  roles: ShieldCheck,
  products: Boxes,
  categories: Tags,
  orders: PackageCheck,
  "payment-methods": CreditCard,
  "discount-codes": BadgePercent,
  articles: BookOpenText,
  tags: Tags,
  "service-scripts": Settings
};
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#10271f" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title} | مدیریت اورنزا</title>
  </head>
  <body class="admin-body">
    <div class="admin-app" data-admin-app>
      <button class="admin-backdrop" type="button" data-admin-menu-close aria-label="بستن منو"></button>
      <aside class="admin-sidebar" data-admin-sidebar>
        <header class="admin-brand">
          <a href="/admin/"><span>O</span><div><strong>ORENZA</strong><small>COFFEE ADMIN</small></div></a>
          <button type="button" data-admin-menu-close aria-label="بستن منو"><X size={19} stroke-width={1.5} /></button>
        </header>
        <nav aria-label="منوی مدیریت">
          <a class:list={{ active: active === "dashboard" }} href="/admin/" data-admin-permission="dashboard">
            <LayoutDashboard size={18} stroke-width={1.45} /><span>داشبورد</span>
          </a>
          {adminResources.filter((resource) => !resource.navHidden).map((resource) => {
            const Icon = icons[resource.key as keyof typeof icons] ?? Boxes;
            return (
              <a class:list={{ active: active === resource.key }} href={`/admin/${resource.key}/list/`} data-admin-permission={resource.key}>
                <Icon size={18} stroke-width={1.45} /><span>{resource.title}</span>
              </a>
            );
          })}
          <a class:list={{ active: active === "site-settings" }} href="/admin/site-settings/" data-admin-permission="site-settings">
            <Settings size={18} stroke-width={1.45} /><span>تنظیمات سایت</span>
          </a>
        </nav>
        <button class="admin-logout" type="button" data-admin-logout>
          <LogOut size={17} stroke-width={1.45} /> خروج از مدیریت
        </button>
      </aside>
      <main class="admin-main">
        <header class="admin-topbar">
          <button class="admin-menu-button" type="button" data-admin-menu-open aria-label="بازکردن منو">
            <Menu size={21} stroke-width={1.4} />
          </button>
          <div class="admin-topbar-context">
            <small>پنل مدیریت / {actionLabel ?? title}</small>
            <strong>{title}</strong>
          </div>
          <div class="admin-topbar-actions">
            <a class="admin-store-link" href="/" target="_blank" rel="noreferrer">مشاهده فروشگاه</a>
            <details class="admin-profile-menu">
              <summary>
                <span class="admin-profile-avatar"><UserRound size={18} stroke-width={1.45} /></span>
                <span><strong data-admin-user>مدیریت اورنزا</strong><small data-admin-role>پنل مدیریت</small></span>
                <ChevronDown size={15} stroke-width={1.45} />
              </summary>
              <div>
                <a href="/admin/profile/"><UserRound size={16} stroke-width={1.45} /><span>پروفایل و امنیت</span></a>
                <button type="button" data-admin-logout><LogOut size={16} stroke-width={1.45} /><span>خروج از حساب</span></button>
              </div>
            </details>
          </div>
        </header>
        <section class="admin-content">
          <header class="admin-page-heading">
            <div>
              <span>ORENZA MANAGEMENT</span>
              <h1>{title}</h1>
              {description && <p>{description}</p>}
            </div>
            <slot name="heading-action" />
          </header>
          <slot />
        </section>
      </main>
      <div class="admin-confirm-layer" data-admin-confirm hidden>
        <button type="button" data-confirm-dismiss aria-label="بستن"></button>
        <section role="alertdialog" aria-modal="true" aria-labelledby="admin-confirm-title">
          <span>ORENZA CONFIRMATION</span>
          <h2 id="admin-confirm-title" data-confirm-title>تأیید عملیات</h2>
          <p data-confirm-message></p>
          <div>
            <button type="button" data-confirm-cancel>انصراف</button>
            <button type="button" data-confirm-accept>تأیید</button>
          </div>
        </section>
      </div>
      <div class="admin-password-layer" data-admin-password-reset hidden>
        <button type="button" data-password-reset-dismiss aria-label="بستن"></button>
        <form data-password-reset-form novalidate>
          <span>USER SECURITY</span>
          <h2>تغییر رمز عبور کاربر</h2>
          <p>رمز تازه برای <strong data-password-reset-user>کاربر</strong> ثبت می‌شود و نشست‌های قبلی او بسته خواهند شد.</p>
          <input type="hidden" name="userId" />
          <label><span>رمز عبور جدید</span><input name="newPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required /></label>
          <label><span>تکرار رمز عبور جدید</span><input name="confirmPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required /></label>
          <small data-password-reset-error aria-live="polite"></small>
          <div>
            <button type="button" data-password-reset-cancel>انصراف</button>
            <button type="submit">ثبت رمز جدید</button>
          </div>
        </form>
      </div>
      <div class="admin-password-layer" data-admin-role-assignment hidden>
        <button type="button" data-role-assignment-dismiss aria-label="بستن"></button>
        <form data-role-assignment-form novalidate>
          <span>ACCESS CONTROL</span>
          <h2>تعیین نقش پنل</h2>
          <p>سطح دسترسی <strong data-role-assignment-user>کاربر</strong> بر اساس نقش انتخابی تنظیم می‌شود.</p>
          <input type="hidden" name="userId" />
          <label>
            <span>نقش پنل</span>
            <select name="roleId">
              <option value="">بدون دسترسی به پنل</option>
            </select>
          </label>
          <small data-role-assignment-error aria-live="polite"></small>
          <div>
            <button type="button" data-role-assignment-cancel>انصراف</button>
            <button type="submit">ثبت سطح دسترسی</button>
          </div>
        </form>
      </div>
      <div class="admin-toasts" data-admin-toasts aria-live="polite"></div>
    </div>
    <script>
      import "../../scripts/admin.ts";
    </script>
  </body>
</html>
