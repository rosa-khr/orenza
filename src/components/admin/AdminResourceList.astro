---
import { Plus } from "@lucide/astro";
import type { AdminResource } from "../../admin/resources";
import AdminShell from "./AdminShell.astro";

interface Props {
  resource: AdminResource;
}

const { resource } = Astro.props;
const columns = resource.fields.filter((field) => field.list);
---

<AdminShell title={resource.title} description={resource.description} active={resource.key} actionLabel="لیست">
  {resource.key !== "payment-methods" && resource.canCreate !== false && (
    <a class="admin-primary-action" href={`/admin/${resource.key}/add/`} slot="heading-action">
      <Plus size={17} stroke-width={1.5} /> افزودن {resource.singular}
    </a>
  )}
  <section
    class="admin-card admin-resource"
    data-admin-resource
    data-resource={resource.key}
    data-mode="list"
  >
    <div class="admin-grid-heading">
      <div>
        <strong>{resource.title}</strong>
        <span>فیلتر و مرتب‌سازی از عنوان هر ستون در دسترس است.</span>
      </div>
      <span data-admin-grid-count>در حال دریافت اطلاعات…</span>
    </div>
    <div class="admin-grid-wrap ag-theme-material">
      <div class="admin-data-grid" data-admin-grid aria-label={`جدول ${resource.title}`}></div>
    </div>
    <script is:inline type="application/json" data-resource-config set:html={JSON.stringify({ ...resource, fields: columns })}></script>
  </section>
</AdminShell>
