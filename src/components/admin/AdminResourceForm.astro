---
import { ArrowRight, Save } from "@lucide/astro";
import { iranianBanks, type AdminResource } from "../../admin/resources";
import AdminFieldControl from "./AdminFieldControl.astro";
import AdminShell from "./AdminShell.astro";

interface Props {
  resource: AdminResource;
  action: "add" | "edit" | "view";
}

const { resource, action } = Astro.props;
const formFields = resource.fields.filter((field) => !field.listOnly);
const labels = { add: "افزودن", edit: "ویرایش", view: "مشاهده" };
const isView = action === "view";
const structuredResources = new Set(["products", "categories", "articles", "tags"]);
const isStructuredForm = structuredResources.has(resource.key);
const supportsCatalogImage = resource.key === "products" || resource.key === "categories" || resource.key === "articles" || resource.key === "tags";
const catalogImageLabel = resource.key === "categories"
  ? "بنر دسته‌بندی"
  : resource.key === "articles"
    ? "بنر مقاله"
    : resource.key === "tags"
      ? "تصویر تگ"
      : "تصویر محصول";
const productPrimaryKeys = ["titleFa", "titleEn", "slug", "categoryId"];
const productFeatureKeys = new Set(["productType", "roastType", "coffeeType", "grindType", "blendType", "saleType", "availableWeightsGrams", "packageWeightGrams"]);
const productPriceKeys = new Set(["purchasePricePerKg", "markupPercent", "salePricePerKg", "profitPerKg", "discountPercent", "discountSalePricePerKg"]);
const productDetailKeys = new Set(["description", "productContent", "tagIds", "relatedProductIds"]);
const sharedSeoKeys = ["seoTitle", "seoDescription", "canonicalUrl"];
const productSeoKeys = new Set(sharedSeoKeys);
const productSidebarKeys = new Set(["imageUrl", "productImageUrls", "stockStatus", "showInBestSellers", "showInDiscounts", "showInPopularFooter", "showInPopularSearches", "isActive"]);
const categoryPrimaryKeys = new Set(["title", "slug", "parentCategoryId"]);
const categoryDetailKeys = new Set(["description"]);
const categorySeoKeys = new Set(sharedSeoKeys);
const categorySidebarKeys = new Set(["imageUrl", "mobileImageUrl", "showInPopularFooter", "showInPopularSearches", "isActive"]);
const articlePrimaryKeys = new Set(["title", "slug"]);
const articleDetailKeys = new Set(["summary", "content", "tags"]);
const articleSeoKeys = new Set(sharedSeoKeys);
const articleSidebarKeys = new Set(["imageUrl", "showInLatest", "isPublished"]);
const tagPrimaryKeys = new Set(["title", "slug"]);
const tagDetailKeys = new Set(["content"]);
const tagSeoKeys = new Set(sharedSeoKeys);
const tagSidebarKeys = new Set(["imageUrl", "showInPopularSearches"]);
const pickFields = (keys: Set<string>) => resource.fields.filter((field) => keys.has(field.key));
const pickOrderedFields = (keys: string[]) =>
  keys.map((key) => resource.fields.find((field) => field.key === key)).filter(Boolean) as typeof resource.fields;
const primaryFields = resource.key === "products"
  ? pickOrderedFields(productPrimaryKeys)
  : resource.key === "categories"
    ? pickFields(categoryPrimaryKeys)
    : resource.key === "articles"
      ? pickFields(articlePrimaryKeys)
      : resource.key === "tags"
        ? pickFields(tagPrimaryKeys)
        : [];
const featureFields = resource.key === "products" ? pickFields(productFeatureKeys) : [];
const priceFields = resource.key === "products" ? pickFields(productPriceKeys) : [];
const detailFields = resource.key === "products"
  ? pickFields(productDetailKeys)
  : resource.key === "categories"
    ? pickFields(categoryDetailKeys)
    : resource.key === "articles"
      ? pickFields(articleDetailKeys)
      : resource.key === "tags"
        ? pickFields(tagDetailKeys)
        : [];
const seoFields = resource.key === "products"
  ? pickFields(productSeoKeys)
  : resource.key === "categories"
    ? pickFields(categorySeoKeys)
    : resource.key === "articles"
      ? pickFields(articleSeoKeys)
      : resource.key === "tags"
        ? pickFields(tagSeoKeys)
        : [];
const sidebarFields = resource.key === "products"
  ? pickFields(productSidebarKeys)
  : resource.key === "categories"
    ? pickFields(categorySidebarKeys)
    : resource.key === "articles"
      ? pickFields(articleSidebarKeys)
      : resource.key === "tags"
        ? pickFields(tagSidebarKeys)
        : [];
const sidebarToggleFields = sidebarFields.filter((field) => !["imageUrl", "mobileImageUrl", "productImageUrls"].includes(field.key));
const sidebarImageField = sidebarFields.find((field) => field.key === "imageUrl");
const categoryMobileImageField = sidebarFields.find((field) => field.key === "mobileImageUrl");
const sidebarGalleryField = sidebarFields.find((field) => field.key === "productImageUrls");
---

<AdminShell
  title={`${labels[action]} ${resource.singular}`}
  description={action === "view" ? "اطلاعات ثبت‌شده را بدون امکان تغییر مرور کنید." : "فیلدهای ضروری را دقیق تکمیل کنید."}
  active={resource.key}
  actionLabel={labels[action]}
>
  <a class="admin-secondary-action" href={`/admin/${resource.key}/list/`} slot="heading-action">
    <ArrowRight size={17} stroke-width={1.5} /> بازگشت به فهرست
  </a>
  <form
    class="admin-card admin-form"
    data-admin-resource
    data-resource={resource.key}
    data-mode={action}
    novalidate
  >
    {isStructuredForm ? (
      <div class="admin-catalog-form-layout">
        <main class="admin-catalog-form-main">
          <section class="admin-form-section">
            <header>
              <strong>اطلاعات اصلی</strong>
            </header>
            <div class="admin-form-grid">
              {primaryFields.map((field) => <AdminFieldControl field={field} resourceKey={resource.key} isView={isView} />)}
            </div>
          </section>
          {resource.key === "products" && (
            <details class="admin-form-accordion">
              <summary>ویژگی‌های محصول</summary>
              <div class="admin-form-grid">
                {featureFields.map((field) => <AdminFieldControl field={field} resourceKey={resource.key} isView={isView} />)}
              </div>
            </details>
          )}
          {resource.key === "products" && (
            <details class="admin-form-accordion" open>
              <summary>قیمت‌گذاری</summary>
              <div class="admin-form-grid">
                {priceFields.map((field) => <AdminFieldControl field={field} resourceKey={resource.key} isView={isView} />)}
              </div>
              <section class="admin-price-breakdown" data-price-breakdown>
                <header><span>محاسبه بر اساس وزن</span><small>مبالغ به تومان</small></header>
                <div></div>
              </section>
            </details>
          )}
          <details class="admin-form-accordion" open={resource.key === "articles"}>
            <summary>محتوا</summary>
            <div class="admin-form-grid">
              {detailFields.map((field) => <AdminFieldControl field={field} resourceKey={resource.key} isView={isView} />)}
            </div>
          </details>
          <details class="admin-form-accordion">
            <summary>سئو</summary>
            <div class="admin-form-grid admin-seo-settings-grid">
              {seoFields.map((field) => <AdminFieldControl field={field} resourceKey={resource.key} isView={isView} />)}
            </div>
          </details>
        </main>
        <aside class="admin-catalog-form-sidebar">
          {supportsCatalogImage ? (
            <section class="admin-product-image-upload" data-catalog-image-upload>
              <div class="admin-product-image-preview">
                <img data-catalog-image-preview hidden alt={`پیش‌نمایش ${catalogImageLabel}`} />
                <span data-catalog-image-placeholder>{catalogImageLabel} هنوز بارگذاری نشده است.</span>
                {!isView && (
                  <button type="button" data-catalog-image-remove hidden>حذف تصویر</button>
                )}
              </div>
              <div>
                <strong>بارگذاری {catalogImageLabel}</strong>
                <small>{resource.key === "products" ? "JPG، PNG یا WebP تا ۵ مگابایت؛ تصویر مربع یا عمودی نتیجه بهتری دارد." : "JPG، PNG یا WebP تا ۵ مگابایت؛ تصویر افقی و عریض نتیجه بهتری دارد."}</small>
                {!isView && (
                  <label>
                    انتخاب و بارگذاری {catalogImageLabel}
                    <input type="file" accept="image/jpeg,image/png,image/webp" multiple={resource.key === "products"} data-catalog-image-input />
                  </label>
                )}
              </div>
              {resource.key === "products" && <div class="admin-product-gallery" data-product-gallery></div>}
            </section>
          ) : sidebarImageField ? (
            <section class="admin-form-section admin-form-section-compact">
              <header>
                <strong>تصویر شاخص</strong>
              </header>
              <AdminFieldControl field={sidebarImageField} resourceKey={resource.key} isView={isView} />
            </section>
          ) : null}
          {supportsCatalogImage && sidebarImageField && <input type="hidden" name={sidebarImageField.key} />}
          {resource.key === "categories" && categoryMobileImageField && (
            <section class="admin-product-image-upload" data-category-mobile-image-upload>
              <div class="admin-product-image-preview">
                <img data-category-mobile-image-preview hidden alt="پیش‌نمایش بنر موبایل دسته‌بندی" />
                <span data-category-mobile-image-placeholder>بنر موبایل هنوز بارگذاری نشده است.</span>
                {!isView && <button type="button" data-category-mobile-image-remove hidden>حذف تصویر</button>}
              </div>
              <div>
                <strong>بارگذاری بنر موبایل</strong>
                <small>JPG، PNG یا WebP تا ۵ مگابایت؛ تصویر عمودی یا مربع نتیجهٔ بهتری دارد. اگر خالی باشد بنر دسکتاپ نمایش داده می‌شود.</small>
                {!isView && (
                  <label>
                    انتخاب و بارگذاری بنر موبایل
                    <input type="file" accept="image/jpeg,image/png,image/webp" data-category-mobile-image-input />
                  </label>
                )}
              </div>
            </section>
          )}
          {resource.key === "categories" && categoryMobileImageField && <input type="hidden" name={categoryMobileImageField.key} />}
          {sidebarGalleryField && <AdminFieldControl field={sidebarGalleryField} resourceKey={resource.key} isView={isView} />}
          {sidebarToggleFields.length > 0 && (
            <section class="admin-form-section admin-form-section-compact">
              <header>
                <strong>نمایش‌ها</strong>
                <small>فلگ‌های فعال و غیرفعال</small>
              </header>
              <div class="admin-flag-stack">
                {sidebarToggleFields.map((field) => <AdminFieldControl field={field} resourceKey={resource.key} isView={isView} />)}
              </div>
            </section>
          )}
        </aside>
      </div>
    ) : (
      <div class="admin-form-grid">
        {formFields.map((field) => <AdminFieldControl field={field} resourceKey={resource.key} isView={isView} />)}
      </div>
    )}
    {resource.key === "payment-methods" && (
      <section class="admin-payment-cards" data-payment-cards hidden>
        <header>
          <div><span>کارت‌های کارت‌به‌کارت</span><small>می‌توانید چند کارت فعال برای پرداخت مشتری داشته باشید.</small></div>
          {!isView && <button type="button" data-card-add>افزودن کارت</button>}
        </header>
        <div class="admin-payment-card-list" data-card-list></div>
        {!isView && (
          <div class="admin-card-editor" data-card-editor hidden>
            <input type="hidden" data-card-input="id" />
            <label><span>شماره کارت</span><input type="text" inputmode="numeric" maxlength="16" dir="ltr" data-card-input="cardNumber" /></label>
            <label><span>شماره شبا</span><input type="text" maxlength="26" dir="ltr" placeholder="IRxxxxxxxxxxxxxxxxxxxxxxxx" data-card-input="shebaNumber" /></label>
            <label><span>شماره حساب</span><input type="text" maxlength="40" dir="ltr" data-card-input="accountNumber" /></label>
            <label><span>نام صاحب حساب</span><input type="text" data-card-input="accountOwner" /></label>
            <label>
              <span>بانک</span>
              <select data-card-input="bankName" data-bank-select>
                <option value="">انتخاب بانک</option>
                {iranianBanks.map((bank) => <option value={bank.value} data-bank-code={bank.code}>{bank.label}</option>)}
              </select>
            </label>
            <label>
              <span>وضعیت کارت</span>
              <select data-card-input="isActive">
                <option value="true">فعال</option>
                <option value="false">غیرفعال</option>
              </select>
            </label>
            <footer><button type="button" data-card-editor-cancel>انصراف</button><button type="button" data-card-save>ذخیره کارت</button></footer>
          </div>
        )}
      </section>
    )}
    {resource.key === "orders" && <section class="admin-order-items" data-order-items hidden></section>}
    {resource.key === "orders" && (
      <section class="admin-payment-review" data-payment-review hidden>
        <header><div><strong>بررسی واریز کارت‌به‌کارت</strong><small>کد پیگیری و تصویر فیش را با گردش حساب تطبیق دهید.</small></div></header>
        <a data-payment-receipt target="_blank" rel="noopener noreferrer"><img data-payment-receipt-image alt="تصویر فیش واریزی مشتری" /></a>
        {!isView && <footer><button type="button" data-payment-reject>رد پرداخت</button><button type="button" data-payment-approve>تأیید پرداخت</button></footer>}
      </section>
    )}
    {resource.key === "orders" && (
      <section class="admin-order-workflow" data-order-workflow hidden>
        <header>
          <div><strong>فرآیند آماده‌سازی و ارسال</strong><small data-order-workflow-state>وضعیت جاری سفارش</small></div>
        </header>
        <div class="admin-order-workflow-steps">
          <span data-workflow-stage="processing"><i>۱</i> در حال آماده‌سازی</span>
          <span data-workflow-stage="ready"><i>۲</i> آماده ارسال</span>
          <span data-workflow-stage="sent"><i>۳</i> ارسال‌شده</span>
        </div>
        <footer>
          <button type="button" data-order-mark-ready hidden>آماده ارسال</button>
          <button type="button" data-order-mark-sent hidden>ثبت ارسال سفارش</button>
        </footer>
      </section>
    )}
    {resource.key === "users" && !isView && (
      <section class="admin-user-security">
        <div><strong>امنیت حساب</strong><small>رمز عبور کاربر را بدون ارسال کد تأیید تغییر دهید.</small></div>
        <button type="button" data-user-password-reset>تغییر رمز عبور</button>
      </section>
    )}
    {!isView && (
      <footer class="admin-form-actions">
        <a href={`/admin/${resource.key}/list/`}>انصراف</a>
        <button type="submit" data-admin-submit><Save size={17} stroke-width={1.45} /> ذخیره تغییرات</button>
      </footer>
    )}
    <div class="admin-loading admin-form-loading" data-admin-form-loading hidden>در حال دریافت اطلاعات…</div>
    <script is:inline type="application/json" data-resource-config set:html={JSON.stringify(resource)}></script>
  </form>
</AdminShell>
