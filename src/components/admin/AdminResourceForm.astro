---
import {
  ArrowRight, Bold, ChevronDown, Columns3,
  ImagePlus, Italic, Link2, List, ListOrdered, Quote, Redo2, RemoveFormatting,
  Rows3, Save, Table2, TextAlignCenter, TextAlignEnd, TextAlignStart, Trash2,
  Underline, Undo2, Unlink2
} from "@lucide/astro";
import { iranianBanks, type AdminResource } from "../../admin/resources";
import AdminShell from "./AdminShell.astro";

interface Props {
  resource: AdminResource;
  action: "add" | "edit" | "view";
}

const { resource, action } = Astro.props;
const labels = { add: "افزودن", edit: "ویرایش", view: "مشاهده" };
const isView = action === "view";
const supportsCatalogImage = resource.key === "products" || resource.key === "categories";
const catalogImageLabel = resource.key === "categories" ? "بنر دسته‌بندی" : "تصویر محصول";
const orderReadonly = new Set([
  "orderNumber", "customerName", "customerPhone", "customerAddress", "totalAmount",
  "discountAmount", "finalAmount", "customerNote"
]);
const moneyFieldKeys = new Set(["purchasePricePerKg", "salePricePerKg"]);
const seoLimitFor = (key: string, fallback?: number) =>
  key === "seoTitle" ? 60 : key === "seoDescription" ? 150 : fallback;
---

<AdminShell
  title={`${labels[action]} ${resource.singular}`}
  description={action === "view" ? "اطلاعات ثبت‌شده را بدون امکان تغییر مرور کنید." : "فیلدهای ضروری را دقیق تکمیل کنید."}
  active={resource.key}
  actionLabel={labels[action]}
>
  <a class="admin-secondary-action" href={`/admin/${resource.key}/list/`} slot="heading-action">
    <ArrowRight size={17} stroke-width={1.5} /> بازگشت به فهرست
  </a>
  <form
    class="admin-card admin-form"
    data-admin-resource
    data-resource={resource.key}
    data-mode={action}
    novalidate
  >
    <div class="admin-form-grid">
      {resource.fields.map((field) => field.type === "permissions" ? (
        <fieldset class="admin-permission-field admin-field wide" data-admin-field={field.key} disabled={isView}>
          <legend>{field.label}{field.required && !isView ? <i>*</i> : null}</legend>
          <div>
            {field.options?.map((option) => (
              <label>
                <input type="checkbox" name={field.key} value={option.value} />
                <span>{option.label}</span>
              </label>
            ))}
          </div>
          <small data-field-error={field.key}></small>
        </fieldset>
      ) : field.type === "richtext" ? (
        <div class="admin-field wide" data-admin-field={field.key}>
          <span>{field.label}{field.required && !isView ? <i>*</i> : null}</span>
          <div class="admin-rich-text" data-rich-text>
            <div class:list={["admin-rich-text-toolbar", { "is-readonly": isView }]} role="toolbar" aria-label={`ابزارهای ویرایش ${field.label}`}>
              <div class="admin-editor-tool-group">
                <button type="button" data-rich-command="undo" disabled={isView} title="واگرد" aria-label="واگرد"><Undo2 /></button>
                <button type="button" data-rich-command="redo" disabled={isView} title="از نو" aria-label="از نو"><Redo2 /></button>
              </div>
              <div class="admin-editor-tool-group admin-editor-format">
                <select data-rich-format disabled={isView} aria-label="نوع متن" title="نوع متن">
                  <option value="p">Paragraph</option>
                  <option value="h2">Heading 2</option>
                  <option value="h3">Heading 3</option>
                  <option value="blockquote">Blockquote</option>
                </select>
                <ChevronDown aria-hidden="true" />
              </div>
              <div class="admin-editor-tool-group">
                <button type="button" data-rich-command="bold" disabled={isView} title="ضخیم" aria-label="ضخیم"><Bold /></button>
                <button type="button" data-rich-command="italic" disabled={isView} title="مورب" aria-label="مورب"><Italic /></button>
                <button type="button" data-rich-command="underline" disabled={isView} title="زیرخط" aria-label="زیرخط"><Underline /></button>
              </div>
              <div class="admin-editor-tool-group">
                <button type="button" data-rich-command="insertUnorderedList" disabled={isView} title="فهرست نقطه‌ای" aria-label="فهرست نقطه‌ای"><List /></button>
                <button type="button" data-rich-command="insertOrderedList" disabled={isView} title="فهرست شماره‌ای" aria-label="فهرست شماره‌ای"><ListOrdered /></button>
                <button type="button" data-rich-command="formatBlock" data-rich-value="blockquote" disabled={isView} title="نقل‌قول" aria-label="نقل‌قول"><Quote /></button>
              </div>
              <div class="admin-editor-tool-group">
                <button type="button" data-rich-command="justifyRight" disabled={isView} title="راست‌چین" aria-label="راست‌چین"><TextAlignEnd /></button>
                <button type="button" data-rich-command="justifyCenter" disabled={isView} title="وسط‌چین" aria-label="وسط‌چین"><TextAlignCenter /></button>
                <button type="button" data-rich-command="justifyLeft" disabled={isView} title="چپ‌چین" aria-label="چپ‌چین"><TextAlignStart /></button>
              </div>
              <div class="admin-editor-tool-group">
                <button type="button" data-rich-command="createLink" disabled={isView} title="افزودن لینک" aria-label="افزودن لینک"><Link2 /></button>
                <button type="button" data-rich-command="unlink" disabled={isView} title="حذف لینک" aria-label="حذف لینک"><Unlink2 /></button>
                <button type="button" data-rich-insert-image disabled={isView} title="افزودن تصویر" aria-label="افزودن تصویر"><ImagePlus /></button>
              </div>
              <details class="admin-editor-table-menu">
                <summary title="ابزارهای جدول" aria-label="ابزارهای جدول"><Table2 /><ChevronDown /></summary>
                <div>
                  <button type="button" data-rich-insert-table disabled={isView}><Table2 /> درج جدول</button>
                  <button type="button" data-rich-table-command="addRowAfter" disabled><Rows3 /> افزودن ردیف</button>
                  <button type="button" data-rich-table-command="addColumnAfter" disabled><Columns3 /> افزودن ستون</button>
                  <button type="button" data-rich-table-command="deleteRow" disabled><Rows3 /> حذف ردیف</button>
                  <button type="button" data-rich-table-command="deleteColumn" disabled><Columns3 /> حذف ستون</button>
                  <button class="is-danger" type="button" data-rich-table-command="deleteTable" disabled><Trash2 /> حذف جدول</button>
                </div>
              </details>
              <div class="admin-editor-tool-group">
                <button type="button" data-rich-command="removeFormat" disabled={isView} title="پاک‌کردن قالب‌بندی" aria-label="پاک‌کردن قالب‌بندی"><RemoveFormatting /></button>
              </div>
              <input type="file" accept="image/jpeg,image/png,image/webp" data-rich-image-input hidden />
            </div>
            <div
              class="admin-rich-text-editor"
              contenteditable={isView ? "false" : "true"}
              role="textbox"
              aria-multiline="true"
              data-rich-text-editor={field.key}
              data-placeholder="متن فارسی را اینجا بنویسید…"
            ></div>
            {!isView && <p class="admin-editor-help">تصویر در محل نشانگر درج می‌شود. جدول آماده را می‌توانید مستقیماً از Excel، Google Sheets، Word یا یک صفحه وب کپی و اینجا Paste کنید.</p>}
            <textarea
              class="admin-rich-text-input"
              name={field.key}
              required={field.required}
              disabled={isView}
              data-rich-text-input={field.key}
              tabindex="-1"
              aria-hidden="true"
            ></textarea>
          </div>
          <small data-field-error={field.key}></small>
        </div>
      ) : (
        <label class:list={["admin-field", { wide: field.type === "textarea" || field.type === "multiselect" }]} data-admin-field={field.key}>
          <span>{field.label}{field.required && !isView ? <i>*</i> : null}</span>
          {field.type === "textarea" ? (
            <textarea
              name={field.key}
              required={field.required}
              disabled={isView || (resource.key === "orders" && orderReadonly.has(field.key))}
              minlength={field.required ? 2 : undefined}
              maxlength={seoLimitFor(field.key, field.maxLength)}
              data-seo-counter-limit={seoLimitFor(field.key)}
            ></textarea>
          ) : field.type === "multiselect" ? (
            <>
              <input type="text" data-tagify-field={field.key} disabled={isView} placeholder="برای جستجو و انتخاب کلیک کنید…" />
              <select class="admin-tagify-source" name={field.key} multiple size="7" disabled={isView} data-dynamic-options={field.key} aria-hidden="true" tabindex="-1"></select>
              <em class="admin-field-help">فقط موارد موجود در فهرست قابل انتخاب هستند و امکان ثبت مقدار جدید وجود ندارد.</em>
            </>
          ) : field.type === "select" ? (
            <select name={field.key} required={field.required} disabled={isView || field.readonly || (resource.key === "orders" && orderReadonly.has(field.key))} data-dynamic-options={!field.options ? field.key : undefined}>
              <option value="">انتخاب کنید</option>
              {field.options?.map((option) => <option value={option.value}>{option.label}</option>)}
            </select>
          ) : (
            <input
              name={field.key}
              type={field.type === "image" || moneyFieldKeys.has(field.key) ? "text" : field.type}
              required={field.required}
              disabled={isView || field.readonly || (resource.key === "orders" && orderReadonly.has(field.key))}
              min={field.min}
              maxlength={seoLimitFor(field.key, field.maxLength)}
              inputmode={moneyFieldKeys.has(field.key) ? "numeric" : undefined}
              data-money-input={moneyFieldKeys.has(field.key) ? "true" : undefined}
              data-seo-counter-limit={seoLimitFor(field.key)}
              dir={moneyFieldKeys.has(field.key) ? "ltr" : field.dir}
            />
          )}
          {seoLimitFor(field.key) && <em class="admin-seo-counter" data-seo-counter={field.key}></em>}
          <small data-field-error={field.key}></small>
        </label>
      ))}
    </div>
    {resource.key === "products" && (
      <section class="admin-price-breakdown" data-price-breakdown>
        <header><span>محاسبه بر اساس وزن</span><small>مبالغ به تومان</small></header>
        <div></div>
      </section>
    )}
    {supportsCatalogImage && (
      <section class="admin-product-image-upload" data-catalog-image-upload>
        <div class="admin-product-image-preview">
          <img data-catalog-image-preview hidden alt={`پیش‌نمایش ${catalogImageLabel}`} />
          <span data-catalog-image-placeholder>{catalogImageLabel} هنوز بارگذاری نشده است.</span>
        </div>
        <div>
          <strong>بارگذاری {catalogImageLabel}</strong>
          <small>{resource.key === "categories" ? "JPG، PNG یا WebP تا ۵ مگابایت؛ تصویر افقی و عریض نتیجه بهتری دارد." : "JPG، PNG یا WebP تا ۵ مگابایت؛ تصویر مربع یا عمودی نتیجه بهتری دارد."}</small>
          {!isView && (
            <label>
              انتخاب و بارگذاری {catalogImageLabel}
              <input type="file" accept="image/jpeg,image/png,image/webp" data-catalog-image-input />
            </label>
          )}
        </div>
      </section>
    )}
    {resource.key === "payment-methods" && (
      <section class="admin-payment-cards" data-payment-cards hidden>
        <header>
          <div><span>کارت‌های کارت‌به‌کارت</span><small>می‌توانید چند کارت فعال برای پرداخت مشتری داشته باشید.</small></div>
          {!isView && <button type="button" data-card-add>افزودن کارت</button>}
        </header>
        <div class="admin-payment-card-list" data-card-list></div>
        {!isView && (
          <div class="admin-card-editor" data-card-editor hidden>
            <input type="hidden" data-card-input="id" />
            <label><span>شماره کارت</span><input type="text" inputmode="numeric" maxlength="16" dir="ltr" data-card-input="cardNumber" /></label>
            <label><span>شماره شبا</span><input type="text" maxlength="26" dir="ltr" placeholder="IRxxxxxxxxxxxxxxxxxxxxxxxx" data-card-input="shebaNumber" /></label>
            <label><span>شماره حساب</span><input type="text" maxlength="40" dir="ltr" data-card-input="accountNumber" /></label>
            <label><span>نام صاحب حساب</span><input type="text" data-card-input="accountOwner" /></label>
            <label>
              <span>بانک</span>
              <select data-card-input="bankName" data-bank-select>
                <option value="">انتخاب بانک</option>
                {iranianBanks.map((bank) => <option value={bank.value} data-bank-code={bank.code}>{bank.label}</option>)}
              </select>
            </label>
            <label>
              <span>وضعیت کارت</span>
              <select data-card-input="isActive">
                <option value="true">فعال</option>
                <option value="false">غیرفعال</option>
              </select>
            </label>
            <footer><button type="button" data-card-editor-cancel>انصراف</button><button type="button" data-card-save>ذخیره کارت</button></footer>
          </div>
        )}
      </section>
    )}
    {resource.key === "orders" && <section class="admin-order-items" data-order-items hidden></section>}
    {resource.key === "orders" && (
      <section class="admin-payment-review" data-payment-review hidden>
        <header><div><strong>بررسی واریز کارت‌به‌کارت</strong><small>کد پیگیری و تصویر فیش را با گردش حساب تطبیق دهید.</small></div></header>
        <a data-payment-receipt target="_blank" rel="noopener noreferrer"><img data-payment-receipt-image alt="تصویر فیش واریزی مشتری" /></a>
        {!isView && <footer><button type="button" data-payment-reject>رد پرداخت</button><button type="button" data-payment-approve>تأیید پرداخت</button></footer>}
      </section>
    )}
    {resource.key === "orders" && (
      <section class="admin-order-workflow" data-order-workflow hidden>
        <header>
          <div><strong>فرآیند آماده‌سازی و ارسال</strong><small data-order-workflow-state>وضعیت جاری سفارش</small></div>
        </header>
        <div class="admin-order-workflow-steps">
          <span data-workflow-stage="processing"><i>۱</i> در حال آماده‌سازی</span>
          <span data-workflow-stage="ready"><i>۲</i> آماده ارسال</span>
          <span data-workflow-stage="sent"><i>۳</i> ارسال‌شده</span>
        </div>
        <footer>
          <button type="button" data-order-mark-ready hidden>آماده ارسال</button>
          <button type="button" data-order-mark-sent hidden>ثبت ارسال سفارش</button>
        </footer>
      </section>
    )}
    {resource.key === "users" && !isView && (
      <section class="admin-user-security">
        <div><strong>امنیت حساب</strong><small>رمز عبور کاربر را بدون ارسال کد تأیید تغییر دهید.</small></div>
        <button type="button" data-user-password-reset>تغییر رمز عبور</button>
      </section>
    )}
    {!isView && (
      <footer class="admin-form-actions">
        <a href={`/admin/${resource.key}/list/`}>انصراف</a>
        <button type="submit" data-admin-submit><Save size={17} stroke-width={1.45} /> ذخیره تغییرات</button>
      </footer>
    )}
    <div class="admin-loading admin-form-loading" data-admin-form-loading hidden>در حال دریافت اطلاعات…</div>
    <script is:inline type="application/json" data-resource-config set:html={JSON.stringify(resource)}></script>
  </form>
</AdminShell>
