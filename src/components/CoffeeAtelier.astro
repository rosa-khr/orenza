---
import { blends, devices, roasts, weights } from "../data/coffee";
import Icon from "./Icon.astro";

const roastImages: Record<number, string> = {
  1: "/images/roast-profiles/light.webp",
  2: "/images/roast-profiles/medium.webp",
  3: "/images/roast-profiles/medium-dark.webp",
  4: "/images/roast-profiles/dark.webp"
};
---

<section class="builder-section atelier-section" id="coffee-builder" aria-labelledby="atelier-title">
  <header class="builder-header atelier-header">
    <p class="eyebrow">ORENZA COFFEE ATELIER</p>
    <h2 id="atelier-title">سفارش اختصاصی قهوه</h2>
    <p>قهوه، رُست و فرم مناسب دستگاهت را انتخاب کن؛ قیمت همان لحظه محاسبه می‌شود.</p>
    <div class="atelier-meta" aria-label="اطلاعات فرایند سفارش">
      <span>چند قدم تا فنجان تو</span>
      <i aria-hidden="true"></i>
      <span>پرداخت پس از مرور سفارش</span>
      <i aria-hidden="true"></i>
      <span>هماهنگی نهایی در پیام‌رسان</span>
    </div>
  </header>

  <ol class="order-progress" aria-label="مراحل ساخت سفارش">
    <li class="is-active" data-progress-step="blend"><button type="button" data-step-nav="blend"><span>۱</span><b>ترکیب</b></button></li>
    <li data-progress-step="roast"><button type="button" data-step-nav="roast"><span>۲</span><b>رُست</b></button></li>
    <li data-progress-step="grind"><button type="button" data-step-nav="grind"><span>۳</span><b>فرم و آسیاب</b></button></li>
    <li data-progress-step="weight"><button type="button" data-step-nav="weight"><span>۴</span><b>وزن</b></button></li>
    <li data-progress-step="summary"><button type="button" data-step-nav="summary"><span>۵</span><b>مرور</b></button></li>
  </ol>

  <div class="coffee-atelier" data-builder>
    <div class="atelier-form">
      <section class="config-section is-ready is-current" data-config-section="blend">
        <header class="config-heading">
          <span>BLEND PROFILE</span>
          <div><h3>انتخاب قهوه</h3><p>ترکیبی را انتخاب کن که به فنجان دلخواهت نزدیک‌تر است.</p></div>
        </header>
        <div class="blend-options">
          {blends.map((blend) => (
            <button class="blend-option" type="button" data-choice="blend" data-value={blend.title} data-en={blend.en} data-fallback-product>
              <span class="option-radio"></span>
              <span class="blend-copy">
                <small>{blend.en}</small>
                <strong>{blend.title}</strong>
                {blend.id === "half" && <span class="recommended-note">پیشنهاد متعادل اورنزا</span>}
                <em>{blend.note}</em><b>{blend.taste}</b>
              </span>
              <span class="coffee-metrics">
                {[
                  ["کافئین", "CAFFEINE", blend.caffeine],
                  ["بادی", "BODY", blend.body],
                  ["اسیدیته", "ACIDITY", blend.acidity],
                  ["کِرما", "CREMA", blend.crema]
                ].map(([label, en, value]) => (
                  <span class="metric">
                    <span><i>{label}</i><small>{en}</small></span>
                    <b><i style={`--metric: ${Number(value) * 20}%`}></i></b>
                  </span>
                ))}
              </span>
            </button>
          ))}
        </div>
      </section>

      <section class="config-section is-locked" data-config-section="roast" aria-disabled="true">
        <header class="config-heading">
          <span>ROAST PROFILE</span>
          <div><h3>پروفایل رُست</h3><p>رُستی را انتخاب کن که به طعم تو نزدیک‌تر است.</p></div>
        </header>
        <div class="roast-options">
          {roasts.map((roast) => (
            <button class={`roast-option roast-option-level-${roast.level}`} type="button" data-choice="roast" data-value={roast.title} data-en={roast.en} data-roast-level={roast.level}>
              <span class="roast-card-visual">
                <img
                  class="roast-bean-photo"
                  src={roastImages[roast.level]}
                  alt={`دانه قهوه با رُست ${roast.title}`}
                  width="360"
                  height="360"
                  loading="lazy"
                  decoding="async"
                />
                <span class="roast-intensity" aria-hidden="true">
                  <i></i>
                </span>
              </span>
              <span><small>{roast.en}</small><strong>{roast.title}</strong><em>{roast.note}</em></span>
            </button>
          ))}
        </div>
      </section>

      <section class="config-section is-locked" data-config-section="grind" aria-disabled="true">
        <header class="config-heading">
          <span>COFFEE FORM</span>
          <div><h3>دان یا آسیاب‌شده</h3><p>دان کامل برای آسیاب تازه؛ آسیاب‌شده برای دم‌آوری بی‌دردسر.</p></div>
        </header>
        <div class="form-options">
          <button type="button" data-choice="grind" data-value="دان کامل" data-en="WHOLE BEAN">
            <span class="form-choice-icon"><img class="form-choice-photo" src="/images/coffee-form/whole-bean-real.png" alt="دانه قهوه برشته" width="240" height="240" loading="lazy" /></span>
            <span><small>WHOLE BEAN</small><strong>دان کامل</strong><em>برای آسیاب در لحظه دم‌آوری</em></span>
          </button>
          <button type="button" data-choice="grind" data-value="آسیاب‌شده" data-en="GROUND COFFEE">
            <span class="form-choice-icon"><img class="form-choice-photo" src="/images/coffee-form/ground-real.png" alt="قهوه آسیاب‌شده" width="240" height="240" loading="lazy" /></span>
            <span><small>GROUND COFFEE</small><strong>آسیاب‌شده</strong><em>تنظیم دقیق برای دستگاه تو</em></span>
          </button>
        </div>
      </section>

      <section class="config-section device-section is-locked" data-config-section="device" aria-disabled="true" hidden>
        <header class="config-heading">
          <span>BREW METHOD</span>
          <div><h3>روش دم‌آوری</h3><p>دستگاهت را انتخاب کن تا درجه آسیاب مشخص شود.</p></div>
        </header>
        <div class="device-options">
          {devices.map((device) => (
            <button type="button" data-choice="device" data-value={device.title} data-en={device.en} data-grind-fa={device.grindFa} data-grind-en={device.grindEn} data-grind-level={device.grind}>
              <span class="device-mark">{device.mark}</span>
              <span><strong>{device.title}</strong><small>{device.en}</small></span>
              <em>{device.grindFa}<small>{device.grindEn}</small></em>
            </button>
          ))}
        </div>
        <div class="mobile-grind-feedback" data-mobile-grind-feedback hidden aria-live="polite">
          <Icon name="grind" size={20} />
          <span><small>GRIND SIZE</small><strong data-mobile-grind-fa>—</strong><em data-mobile-grind-en>—</em></span>
          <i aria-hidden="true"></i>
        </div>
      </section>

      <section class="config-section is-locked" data-config-section="weight" aria-disabled="true">
        <header class="config-heading">
          <span>PACK SIZE</span>
          <div><h3>وزن سفارش</h3><p>به‌اندازه مصرفت انتخاب کن تا قهوه تازه بماند.</p></div>
        </header>
        <div class="weight-options">
          {weights.map((weight) => (
            <button type="button" data-choice="weight" data-value={weight.label} data-grams={weight.grams}>
              <span class="option-radio"></span><strong>{weight.label}</strong><small data-weight-price>—</small>
            </button>
          ))}
        </div>
        <div class="quantity-choice">
          <span>تعداد بسته</span>
          <div>
            <button type="button" data-quantity-minus aria-label="کم‌کردن تعداد">−</button>
            <output data-quantity>۱</output>
            <button type="button" data-quantity-plus aria-label="افزودن تعداد">+</button>
          </div>
        </div>
      </section>

      <section class="order-summary is-locked" data-config-section="summary" aria-disabled="true">
        <div class="summary-title">
          <span>ORDER REVIEW</span>
          <div>
            <h3>مرور سفارش شما</h3>
            <p class="summary-note">پیش از افزودن به سبد، انتخاب‌ها را یک‌بار مرور کن.</p>
          </div>
        </div>
        <dl class="result-list">
          <div><dt>ترکیب <small>BLEND</small></dt><dd data-result="blend">—</dd></div>
          <div><dt>درجه رُست <small>ROAST</small></dt><dd data-result="roast">—</dd></div>
          <div><dt>فرم قهوه <small>FORM</small></dt><dd data-result="grind">—</dd></div>
          <div data-device-result hidden><dt>روش دم‌آوری <small>BREW METHOD</small></dt><dd data-result="device">—</dd></div>
          <div data-grind-result hidden><dt>درجه آسیاب <small>GRIND SIZE</small></dt><dd data-result="grindSize">—</dd></div>
          <div><dt>وزن <small>WEIGHT</small></dt><dd data-result="weight">—</dd></div>
          <div><dt>تعداد <small>QUANTITY</small></dt><dd data-result="quantity">۱</dd></div>
          <div><dt>مبلغ <small>ITEM TOTAL</small></dt><dd data-result="price">—</dd></div>
        </dl>
        <div class="result-actions">
          <button class="button button-primary" type="button" data-add-cart>افزودن به سبد سفارش</button>
          <button class="restart-button" type="button" data-restart>پاک‌کردن انتخاب‌ها</button>
        </div>
      </section>
    </div>
  </div>
</section>
