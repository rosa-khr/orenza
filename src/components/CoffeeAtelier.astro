---
import { blends, devices, roasts, weights } from "../data/coffee";
import Icon from "./Icon.astro";

const roastImages: Record<number, string> = {
  1: "/images/roast-profiles/light.webp",
  2: "/images/roast-profiles/medium.webp",
  3: "/images/roast-profiles/medium-dark.webp",
  4: "/images/roast-profiles/dark.webp"
};

const robustaShare = (blend: typeof blends[number]) => {
  if (blend.en === "HOUSE BALANCE") return 50;
  const percent = Number(blend.en.match(/\d+/)?.[0] || 0);
  return blend.en.includes("ROBUSTA") ? percent : 100 - percent;
};

const blendLevels = [...blends].sort((first, second) =>
  first.caffeine - second.caffeine ||
  robustaShare(first) - robustaShare(second) ||
  first.body - second.body
);

const initialBlend = blendLevels[0];
const initialRoast = roasts[0];
const grindLevels = devices
  .filter((device) => device.id !== "other")
  .sort((first, second) => first.grind - second.grind);
const initialGrindLevel = grindLevels[0];
---

<section class="builder-section atelier-section" id="coffee-builder" aria-labelledby="atelier-title">
  <header class="builder-header atelier-header">
    <p class="eyebrow">ORENZA COFFEE ATELIER</p>
    <h2 id="atelier-title">سفارش اختصاصی قهوه</h2>
    <p>قهوه‌ات را بر اساس ذائقه، روش دم‌آوری و مقدار مصرفت بساز؛ ما آن را تازه آماده می‌کنیم و پیش از ارسال جزئیات سفارش را با تو هماهنگ می‌کنیم.</p>
    <div class="atelier-meta" aria-label="اطلاعات فرایند سفارش">
      <span>انتخاب مرحله‌به‌مرحله</span>
      <i aria-hidden="true"></i>
      <span>مرور دقیق پیش از پرداخت</span>
      <i aria-hidden="true"></i>
      <span>آماده‌سازی تازه برای سفارش شما</span>
    </div>
  </header>

  <ol class="order-progress" aria-label="مراحل ساخت سفارش">
    <li class="is-active" data-progress-step="blend"><button type="button" data-step-nav="blend"><span>۱</span><b>ترکیب</b></button></li>
    <li data-progress-step="roast"><button type="button" data-step-nav="roast"><span>۲</span><b>رُست</b></button></li>
    <li data-progress-step="grind"><button type="button" data-step-nav="grind"><span>۳</span><b>فرم و آسیاب</b></button></li>
    <li data-progress-step="weight"><button type="button" data-step-nav="weight"><span>۴</span><b>وزن</b></button></li>
    <li data-progress-step="summary"><button type="button" data-step-nav="summary"><span>۵</span><b>مرور</b></button></li>
  </ol>

  <div class="coffee-atelier" data-builder>
    <div class="atelier-form">
      <section class="config-section is-ready is-current" data-config-section="blend">
        <div class="step-flow-actions">
          <button class="step-next-button" type="button" data-step-next disabled>
            <span>بعدی</span>
            <Icon name="arrow" size={15} />
          </button>
        </div>
        <header class="config-heading">
          <span>BLEND PROFILE</span>
          <div><h3>میزان کافئین</h3><p>اسلایدر را از راست به چپ ببر تا کافئین و قدرت فنجان بیشتر شود.</p></div>
        </header>
        <div class="blend-slider-panel" data-blend-slider>
          <div class="blend-slider-guide">
            <span>راهنما</span>
            <strong>با حرکت از راست به چپ، روبوستا و کافئین بیشتر می‌شود.</strong>
          </div>
          <div class="blend-slider-shell">
            <div class="blend-slider-readout" aria-live="polite">
              <small data-blend-en>{initialBlend.en}</small>
              <strong data-blend-title>{initialBlend.title}</strong>
              <em data-blend-note>{initialBlend.note}</em>
              <b data-blend-taste>{initialBlend.taste}</b>
            </div>
            <label class="blend-range-label" for="blend-caffeine-range">درجه کافئین</label>
            <input
              id="blend-caffeine-range"
              class="blend-caffeine-range"
              type="range"
              min="0"
              max={blendLevels.length - 1}
              step="1"
              value="0"
              data-blend-range
              aria-describedby="blend-slider-help"
            />
            <div class="blend-slider-scale" aria-hidden="true">
              <span>ملایم‌تر</span>
              <span>پرکافئین‌تر</span>
            </div>
            <p id="blend-slider-help">هر توقف اسلایدر اطلاعات همان ترکیب را نشان می‌دهد.</p>
          </div>
          <div class="blend-slider-metrics">
            {[
              ["کافئین", "CAFFEINE", "caffeine", initialBlend.caffeine],
              ["بادی", "BODY", "body", initialBlend.body],
              ["اسیدیته", "ACIDITY", "acidity", initialBlend.acidity],
              ["کِرما", "CREMA", "crema", initialBlend.crema]
            ].map(([label, en, key, value]) => (
              <span class="blend-slider-metric">
                <span><i>{label}</i><small>{en}</small></span>
                <b><i data-blend-metric={key} style={`--metric: ${Number(value) * 20}%`}></i></b>
              </span>
            ))}
          </div>
          <div class="blend-slider-steps" aria-label="سطح‌های کافئین">
            {blendLevels.map((blend, index) => (
              <button
                class={index === 0 ? "is-active" : ""}
                type="button"
                data-blend-slider-step
                data-index={index}
                data-target-value={blend.title}
                data-target-en={blend.en}
                data-note={blend.note}
                data-taste={blend.taste}
                data-caffeine={blend.caffeine}
                data-body={blend.body}
                data-acidity={blend.acidity}
                data-crema={blend.crema}
              >
                <span>{index + 1}</span>
                <b>{blend.title}</b>
              </button>
            ))}
          </div>
        </div>
        <div class="blend-options is-slider-source">
          {blends.map((blend) => (
            <button class="blend-option" type="button" data-choice="blend" data-value={blend.title} data-en={blend.en} data-fallback-product>
              <span class="option-radio"></span>
              <span class="blend-copy">
                <small>{blend.en}</small>
                <strong>{blend.title}</strong>
                {blend.id === "half" && <span class="recommended-note">پیشنهاد متعادل اورنزا</span>}
                <em>{blend.note}</em><b>{blend.taste}</b>
              </span>
              <span class="coffee-metrics">
                {[
                  ["کافئین", "CAFFEINE", blend.caffeine],
                  ["بادی", "BODY", blend.body],
                  ["اسیدیته", "ACIDITY", blend.acidity],
                  ["کِرما", "CREMA", blend.crema]
                ].map(([label, en, value]) => (
                  <span class="metric">
                    <span><i>{label}</i><small>{en}</small></span>
                    <b><i style={`--metric: ${Number(value) * 20}%`}></i></b>
                  </span>
                ))}
              </span>
            </button>
          ))}
        </div>
      </section>

      <section class="config-section is-locked" data-config-section="roast" aria-disabled="true">
        <div class="step-flow-actions">
          <button class="step-back-button" type="button" data-step-back>
            <Icon name="arrow" size={15} />
            <span>بازگشت</span>
          </button>
          <button class="step-next-button" type="button" data-step-next disabled>
            <span>بعدی</span>
            <Icon name="arrow" size={15} />
          </button>
        </div>
        <header class="config-heading">
          <span>ROAST PROFILE</span>
          <div><h3>درجه رُست</h3><p>اسلایدر را از راست به چپ ببر تا رُست تیره‌تر و بادی بیشتر شود.</p></div>
        </header>
        <div class="blend-slider-panel profile-slider-panel" data-roast-slider>
          <div class="blend-slider-guide">
            <span>راهنما</span>
            <strong>با حرکت از راست به چپ، درجه رُست از روشن به تیره می‌رسد.</strong>
          </div>
          <div class="blend-slider-shell">
            <div class="blend-slider-readout profile-slider-readout" aria-live="polite">
              <span class="profile-slider-visual">
                <img data-roast-image src={roastImages[initialRoast.level]} alt={`دانه قهوه با رُست ${initialRoast.title}`} width="180" height="180" loading="lazy" />
              </span>
              <small data-roast-en>{initialRoast.en}</small>
              <strong data-roast-title>{initialRoast.title}</strong>
              <em data-roast-note>{initialRoast.note}</em>
            </div>
            <label class="blend-range-label" for="roast-level-range">درجه رُست</label>
            <input
              id="roast-level-range"
              class="blend-caffeine-range"
              type="range"
              min="0"
              max={roasts.length - 1}
              step="1"
              value="0"
              data-roast-range
              aria-describedby="roast-slider-help"
            />
            <div class="blend-slider-scale" aria-hidden="true">
              <span>روشن‌تر</span>
              <span>تیره‌تر</span>
            </div>
            <p id="roast-slider-help">هر توقف اسلایدر اطلاعات همان رُست را نشان می‌دهد.</p>
          </div>
          <div class="blend-slider-steps" aria-label="درجه‌های رُست">
            {roasts.map((roast, index) => (
              <button
                class={index === 0 ? "is-active" : ""}
                type="button"
                data-roast-slider-step
                data-index={index}
                data-target-value={roast.title}
                data-target-en={roast.en}
                data-note={roast.note}
                data-level={roast.level}
                data-image={roastImages[roast.level]}
              >
                <span>{index + 1}</span>
                <b>{roast.title}</b>
              </button>
            ))}
          </div>
        </div>
        <div class="roast-options is-slider-source">
          {roasts.map((roast) => (
            <button class={`roast-option roast-option-level-${roast.level}`} type="button" data-choice="roast" data-value={roast.title} data-en={roast.en} data-roast-level={roast.level}>
              <span class="roast-card-visual">
                <img
                  class="roast-bean-photo"
                  src={roastImages[roast.level]}
                  alt={`دانه قهوه با رُست ${roast.title}`}
                  width="360"
                  height="360"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="roast-copy"><small>{roast.en}</small><strong>{roast.title}</strong><em>{roast.note}</em></span>
              <span class="coffee-metrics roast-metrics roast-level-meter">
                <span class="metric">
                  <span><i>درجه رُست</i><small>ROAST LEVEL</small></span>
                  <b><i style={`--metric: ${roast.level * 25}%`}></i></b>
                </span>
              </span>
            </button>
          ))}
        </div>
      </section>

      <section class="config-section is-locked" data-config-section="grind" aria-disabled="true">
        <div class="step-flow-actions">
          <button class="step-back-button" type="button" data-step-back>
            <Icon name="arrow" size={15} />
            <span>بازگشت</span>
          </button>
          <button class="step-next-button" type="button" data-step-next disabled>
            <span>بعدی</span>
            <Icon name="arrow" size={15} />
          </button>
        </div>
        <header class="config-heading">
          <span>COFFEE FORM</span>
          <div><h3>دان یا آسیاب‌شده</h3><p>دان کامل برای آسیاب تازه؛ آسیاب‌شده برای دم‌آوری بی‌دردسر.</p></div>
        </header>
        <div class="form-options">
          <button type="button" data-choice="grind" data-value="دان کامل" data-en="WHOLE BEAN">
            <span class="form-choice-icon"><img class="form-choice-photo" src="/images/coffee-form/whole-bean-real.png" alt="دانه قهوه برشته" width="240" height="240" loading="lazy" /></span>
            <span><small>WHOLE BEAN</small><strong>دان کامل</strong><em>برای آسیاب در لحظه دم‌آوری</em></span>
          </button>
          <button type="button" data-choice="grind" data-value="آسیاب‌شده" data-en="GROUND COFFEE">
            <span class="form-choice-icon"><img class="form-choice-photo" src="/images/coffee-form/ground-real.png" alt="قهوه آسیاب‌شده" width="240" height="240" loading="lazy" /></span>
            <span><small>GROUND COFFEE</small><strong>آسیاب‌شده</strong><em>تنظیم دقیق برای دستگاه تو</em></span>
          </button>
        </div>
      </section>

      <section class="config-section device-section is-locked" data-config-section="device" aria-disabled="true" hidden>
        <div class="step-flow-actions">
          <button class="step-back-button" type="button" data-step-back>
            <Icon name="arrow" size={15} />
            <span>بازگشت</span>
          </button>
          <button class="step-next-button" type="button" data-step-next disabled>
            <span>بعدی</span>
            <Icon name="arrow" size={15} />
          </button>
        </div>
        <header class="config-heading">
          <span>BREW METHOD</span>
          <div><h3>درجه آسیاب</h3><p>اسلایدر را از راست به چپ ببر تا آسیاب از ریز به درشت برسد.</p></div>
        </header>
        <div class="blend-slider-panel profile-slider-panel" data-grind-slider>
          <div class="blend-slider-guide">
            <span>راهنما</span>
            <strong>با حرکت از راست به چپ، درجه آسیاب درشت‌تر می‌شود و روش مناسبش نمایش داده می‌شود.</strong>
          </div>
          <div class="blend-slider-shell">
            <div class="blend-slider-readout profile-slider-readout grind-slider-readout" aria-live="polite">
              <small data-grind-method-en>{initialGrindLevel.en}</small>
              <strong data-grind-method-title>{initialGrindLevel.title}</strong>
              <em data-grind-method-fa>{initialGrindLevel.grindFa}</em>
              <b data-grind-method-en-size>{initialGrindLevel.grindEn}</b>
            </div>
            <label class="blend-range-label" for="grind-level-range">درجه آسیاب</label>
            <input
              id="grind-level-range"
              class="blend-caffeine-range"
              type="range"
              min="0"
              max={grindLevels.length - 1}
              step="1"
              value="0"
              data-grind-range
              aria-describedby="grind-slider-help"
            />
            <div class="blend-slider-scale" aria-hidden="true">
              <span>ریزتر</span>
              <span>درشت‌تر</span>
            </div>
            <p id="grind-slider-help">هر توقف اسلایدر روش دم‌آوری و اندازه آسیاب مناسب را نشان می‌دهد.</p>
            <label class="grind-size-custom">
              <span>روش دم‌آوری</span>
              <input type="text" placeholder="اگر در اسلایدر نیست، اینجا بنویس" data-grind-method-custom-input />
            </label>
            <label class="grind-size-custom">
              <span>سایز آسیاب</span>
              <input type="text" placeholder="اختیاری؛ مثلاً ۹ یا کمی درشت‌تر" data-grind-size-custom-input />
            </label>
          </div>
          <div class="blend-slider-steps" aria-label="درجه‌های آسیاب">
            {grindLevels.map((device, index) => (
              <button
                class={index === 0 ? "is-active" : ""}
                type="button"
                data-grind-slider-step
                data-index={index}
                data-target-value={device.title}
                data-target-en={device.en}
                data-grind-fa={device.grindFa}
                data-grind-en={device.grindEn}
                data-grind-level={device.grind}
              >
                <span>{index + 1}</span>
                <b>{device.grindFa}</b>
              </button>
            ))}
          </div>
        </div>
        <div class="device-picker is-slider-source" data-device-picker>
          <div class="device-picker-results" id="device-picker-results" role="listbox" data-device-picker-results>
            {devices.map((device) => (
              <button
                type="button"
                role="option"
                data-device-picker-option
                data-device-other={device.id === "other" ? "true" : undefined}
                data-device-value={device.title}
              >
                <span><strong>{device.title}</strong><small>{device.en}</small></span>
                <em>{device.grindFa}<small>{device.grindEn}</small></em>
              </button>
            ))}
          </div>
          <div class="device-picker-custom" data-device-picker-custom hidden>
            <label>
              <span>نام دستگاه یا روش دم‌آوری</span>
              <input type="text" placeholder="مثلاً کمکس، کلدبرو یا دستگاه دیگر" autocomplete="off" data-device-picker-custom-input />
            </label>
            <button type="button" data-device-picker-custom-submit>تایید</button>
          </div>
          <div class="device-picker-selection" data-device-picker-selection hidden>
            <span>انتخاب شما</span>
            <strong data-device-picker-selected>—</strong>
            <small data-device-picker-grind>—</small>
            <button type="button" data-device-picker-edit hidden>ویرایش</button>
          </div>
        </div>
        <div class="device-options" hidden aria-hidden="true">
          {devices.map((device) => (
            <button type="button" data-choice="device" data-value={device.title} data-en={device.en} data-grind-fa={device.grindFa} data-grind-en={device.grindEn} data-grind-level={device.grind}>
              <span class="device-mark">{device.mark}</span>
              <span><strong>{device.title}</strong><small>{device.en}</small></span>
              <em>{device.grindFa}<small>{device.grindEn}</small></em>
            </button>
          ))}
        </div>
      </section>

      <section class="config-section is-locked" data-config-section="weight" aria-disabled="true">
        <div class="step-flow-actions">
          <button class="step-back-button" type="button" data-step-back>
            <Icon name="arrow" size={15} />
            <span>بازگشت</span>
          </button>
          <button class="step-next-button" type="button" data-step-next disabled>
            <span>بعدی</span>
            <Icon name="arrow" size={15} />
          </button>
        </div>
        <header class="config-heading">
          <span>PACK SIZE</span>
          <div><h3>وزن سفارش</h3><p>به‌اندازه مصرفت انتخاب کن تا قهوه تازه بماند.</p></div>
        </header>
        <div class="weight-options">
          {weights.map((weight) => (
            <button type="button" data-choice="weight" data-value={weight.label} data-grams={weight.grams}>
              <span class="option-radio"></span><strong>{weight.label}</strong><small data-weight-price>—</small>
            </button>
          ))}
        </div>
        <div class="quantity-choice">
          <span>تعداد بسته</span>
          <div>
            <button type="button" data-quantity-minus aria-label="کم‌کردن تعداد">−</button>
            <output data-quantity>۱</output>
            <button type="button" data-quantity-plus aria-label="افزودن تعداد">+</button>
          </div>
        </div>
      </section>

      <section class="order-summary is-locked" data-config-section="summary" aria-disabled="true">
        <div class="step-flow-actions">
          <button class="step-back-button" type="button" data-step-back>
            <Icon name="arrow" size={15} />
            <span>بازگشت</span>
          </button>
        </div>
        <div class="summary-title">
          <span>ORDER REVIEW</span>
          <div>
            <h3>مرور سفارش شما</h3>
            <p class="summary-note">پیش از افزودن به سبد، انتخاب‌ها را یک‌بار مرور کن.</p>
          </div>
        </div>
        <dl class="result-list">
          <div><dt>ترکیب <small>BLEND</small></dt><dd data-result="blend">—</dd></div>
          <div><dt>درجه رُست <small>ROAST</small></dt><dd data-result="roast">—</dd></div>
          <div><dt>فرم قهوه <small>FORM</small></dt><dd data-result="grind">—</dd></div>
          <div data-device-result hidden><dt>روش دم‌آوری <small>BREW METHOD</small></dt><dd data-result="device">—</dd></div>
          <div data-grind-result hidden><dt>درجه آسیاب <small>GRIND SIZE</small></dt><dd data-result="grindSize">—</dd></div>
          <div><dt>وزن <small>WEIGHT</small></dt><dd data-result="weight">—</dd></div>
          <div><dt>تعداد <small>QUANTITY</small></dt><dd data-result="quantity">۱</dd></div>
          <div><dt>مبلغ <small>ITEM TOTAL</small></dt><dd data-result="price">—</dd></div>
        </dl>
        <div class="result-actions">
          <button class="button button-primary" type="button" data-add-cart>افزودن به سبد سفارش</button>
          <button class="restart-button" type="button" data-restart>پاک‌کردن انتخاب‌ها</button>
        </div>
      </section>
    </div>
  </div>
</section>

<script>
  import "../scripts/device-picker.ts";
</script>
