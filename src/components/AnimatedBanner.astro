<section class="espresso-banner" aria-labelledby="espresso-banner-title">
  <div class="espresso-banner-copy">
    <p>THE ORENZA SIGNATURE</p>
    <h2 id="espresso-banner-title">یک شات خوب،<br />با عجله به دست نمی‌آید.</h2>
    <span>آسیاب درست، فشار پایدار و چند ثانیه صبر؛ تفاوت یک اسپرسوی معمولی با فنجانی که به یاد می‌ماند همین‌جاست.</span>
  </div>

  <div class="espresso-scene" aria-hidden="true">
    <img
      class="espresso-machine-photo"
      src="/images/espresso-machine-real-v1.webp"
      alt=""
      width="1024"
      height="1536"
      loading="lazy"
    />
    <div class="machine-interface">
      <div class="program-panel">
        <span class="program-option"><i></i><b>RISTRETTO</b><small>25 ML</small></span>
        <span class="program-option is-active"><i></i><b>ESPRESSO</b><small>30 ML</small></span>
        <span class="program-option"><i></i><b>LUNGO</b><small>60 ML</small></span>
      </div>
      <div class="shot-timer">
        <span>EXTRACTION</span>
        <b>05 SEC</b>
        <i><em></em></i>
      </div>
    </div>
    <div class="coffee-flow flow-one"></div>
    <div class="coffee-flow flow-two"></div>
    <div class="shot-glass">
      <div class="espresso-fill"><span class="crema"></span></div>
    </div>
    <span class="shot-shadow"></span>
    <span class="aroma aroma-one"></span>
    <span class="aroma aroma-two"></span>
    <span class="counter-line"></span>
  </div>

  <div class="espresso-ticker" aria-hidden="true">
    <div>
      <span>FRESHLY ROASTED</span><i>✦</i>
      <span>GROUND FOR YOUR BREWER</span><i>✦</i>
      <span>CRAFTED IN IRAN</span><i>✦</i>
      <span>FRESHLY ROASTED</span><i>✦</i>
      <span>GROUND FOR YOUR BREWER</span><i>✦</i>
      <span>CRAFTED IN IRAN</span><i>✦</i>
    </div>
  </div>
</section>
