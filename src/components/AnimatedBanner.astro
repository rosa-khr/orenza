---
import { BadgeCheck, RefreshCcw, ShieldCheck, Truck } from "@lucide/astro";

const benefits = [
  {
    title: "ارسال سریع",
    description: "تهران و کرج، آماده‌سازی و ارسال سریع‌تر.",
    icon: Truck
  },
  {
    title: "ضمانت اصالت",
    description: "دانه و مواد اولیه با منشأ مشخص.",
    icon: ShieldCheck
  },
  {
    title: "امکان مرجوعی",
    description: "ایراد واقعی سفارش را پیگیری و جبران می‌کنیم.",
    icon: RefreshCcw
  },
  {
    title: "کیفیت ثابت",
    description: "ترکیب، رست و آسیاب با استاندارد ثابت.",
    icon: BadgeCheck
  }
];
---

<section id="espresso-ritual" class="espresso-banner" aria-labelledby="espresso-banner-title">
  <div class="espresso-banner-copy">
    <p>WHY ORENZA</p>
    <h2 id="espresso-banner-title">چرا اورنزا را انتخاب کنیم؟</h2>
    <span>خرید قهوه باید هم خوش‌طعم باشد، هم دقیق، سریع و قابل اعتماد.</span>
  </div>

  <div class="orenza-benefit-grid" aria-label="مزیت‌های خرید از اورنزا">
    {benefits.map((benefit) => {
      const BenefitIcon = benefit.icon;
      return (
        <article>
          <span class="orenza-benefit-icon" aria-hidden="true">
            <BenefitIcon size={42} stroke-width={1.45} />
          </span>
          <div>
            <h3>{benefit.title}</h3>
            <p>{benefit.description}</p>
          </div>
        </article>
      );
    })}
  </div>
</section>
