---
const selectionSteps = [
  {
    number: "01",
    title: "بر اساس طعم انتخاب کنید",
    description: "از طعم‌های قوی و تلخ تا انتخاب‌های ملایم، گیاهی و معطر."
  },
  {
    number: "02",
    title: "تفاوت محصولات را بشناسید",
    description: "ترکیبات، ویژگی‌ها و روش مصرف هر محصول به‌صورت روشن و قابل مقایسه ارائه می‌شود."
  },
  {
    number: "03",
    title: "برای موقعیت مناسب انتخاب کنید",
    description: "برای شروع روز، پذیرایی، استراحت یا یک انتخاب روزمره؛ هر محصول کاربرد خودش را دارد."
  }
];
---

<section id="espresso-ritual" class="espresso-banner" aria-labelledby="espresso-banner-title">
  <div class="espresso-banner-copy">
    <p>ORENZA SELECTION</p>
    <h2 id="espresso-banner-title">انتخابی که از سلیقه شما شروع می‌شود</h2>
    <span>
      محصول مناسب برای هر کسی یکسان نیست.<br />
      در اورنزا، انتخاب را بر اساس طعم، سبک مصرف و موقعیتی که برای آن خرید می‌کنید ساده‌تر می‌کنیم.
    </span>
  </div>

  <div class="orenza-selection-grid" aria-label="راهنمای انتخاب محصولات اورنزا">
    {selectionSteps.map((step) => (
      <article>
        <span class="orenza-selection-number" aria-hidden="true">{step.number}</span>
        <h3>{step.title}</h3>
        <p>{step.description}</p>
      </article>
    ))}
  </div>
</section>
