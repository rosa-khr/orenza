---
import Icon from "./Icon.astro";
import IosInstallPrompt from "./IosInstallPrompt.astro";
---

<footer class="site-footer" id="contact" dir="rtl">
  <img class="site-footer__decor" src="/images/footer-coffee-branch.png" alt="" width="504" height="1281" loading="eager" decoding="async" aria-hidden="true" />

  <IosInstallPrompt />

  <div class="site-footer__container">
    <section class="site-footer__brand-panel" aria-label="معرفی اورنزا">
      <a class="site-footer__brand-mark" href="/" aria-label="اورنزا، صفحه اصلی">
        <span class="site-footer__logo-text" dir="ltr" data-site-brand-name-en>ORENZA</span>
        <span class="site-footer__tagline" dir="ltr">COFFEE FOR A BRIGHTER DAY</span>
      </a>
      <p data-site-footer-description>قهوه تازه، انتخاب دقیق و تجربه‌ای آرام برای لحظه‌های بهتر زندگی.</p>
    </section>

    <nav class="site-footer__column" aria-label="دسترسی سریع" data-footer-quick-links>
      <div class="site-footer__menu">
        <h2>دسترسی سریع</h2>
        <div class="site-footer__menu-links">
          <a href="/category/coffee-blends/">قهوه</a>
          <a href="/category/cafe-drinks/">دمنوش و نوشیدنی‌ها</a>
          <a href="#coffee-equipment">ملزومات قهوه</a>
          <a href="/products/">همه محصولات اورنزا</a>
        </div>
      </div>
    </nav>

    <nav class="site-footer__column" aria-label="دسترسی سریع">
      <div class="site-footer__menu">
        <h2>صفحات</h2>
        <div class="site-footer__menu-links">
          <a href="/products/">فروشگاه</a>
          <a href="/articles/">مجله قهوه</a>
          <a href="/about/">درباره اورنزا</a>
          <a href="/contact/">تماس با ما</a>
          <a href="/terms/">قوانین سایت</a>
        </div>
      </div>
    </nav>

    <section class="site-footer__connect" aria-labelledby="site-footer-connect-title">
      <h2 id="site-footer-connect-title" data-site-footer-heading>ارتباط و شبکه‌های اجتماعی</h2>
      <address class="site-footer__contact-list">
        <a href="tel:+989103060396" dir="ltr" data-site-phone-link><Icon name="phone" size={17} /><span data-site-phone>0910 306 0396</span></a>
        <a href="mailto:order.orenzacoffee@gmail.com" dir="ltr" data-site-email-link><Icon name="email" size={17} /><span data-site-email>order.orenzacoffee@gmail.com</span></a>
      </address>
      <span class="site-footer__social-label">شبکه‌های اجتماعی</span>
      <div class="site-footer__social" aria-label="شبکه‌های اجتماعی">
        <a href="https://instagram.com/orenza.ir" rel="me noreferrer" target="_blank" aria-label="Instagram" data-site-instagram-link>
          <Icon name="instagram" size={18} />
        </a>
        <a href="https://t.me/orenza_ir" rel="me noreferrer" target="_blank" aria-label="Telegram" data-site-telegram-link>
          <Icon name="send" size={18} />
        </a>
        <a href="https://wa.me/989103060396" rel="noreferrer" target="_blank" aria-label="WhatsApp" data-site-whatsapp-link>
          <Icon name="whatsapp" size={18} />
        </a>
        <a href="https://ble.ir/khoobrooz" rel="me noreferrer" target="_blank" aria-label="Bale" data-site-bale-link>
          <Icon name="bale" size={18} />
        </a>
      </div>
    </section>
  </div>

  <div class="site-footer__bottom">
    <div class="site-footer__bottom-inner">
      <div class="site-footer__legal" aria-label="حقوق سایت">
        <span class="site-footer__legal-copy" dir="rtl" data-site-footer-copyright>تمامی حقوق قهوه اورنزا محفوظ است.</span>
        <span class="site-footer__legal-mark" dir="ltr" data-site-footer-copyright-en>orenza @2026</span>
      </div>
    </div>
  </div>
</footer>
