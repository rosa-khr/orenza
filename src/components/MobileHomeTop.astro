---
import Icon from "./Icon.astro";
import CoffeeBeanIcon from "./CoffeeBeanIcon.astro";
---

<section class="mobile-home-top" aria-label="دسترسی سریع فروشگاه">
  <nav class="mobile-quick-links" aria-label="دسته‌های اصلی" data-mobile-quick-links>
    <a href="/category/coffee-blends/" data-quick-icon="bean"><span><CoffeeBeanIcon size={27} /></span><b>قهوه</b></a>
    <a href="/category/cafe-drinks/" data-quick-icon="drink"><span><Icon name="coffee" size={25} /></span><b>نوشیدنی پودری</b></a>
    <a href="/category/herbal-tea/" data-quick-icon="herbal"><span><Icon name="coffee" size={25} /></span><b>دمنوش</b></a>
    <a href="/wholesale/" data-quick-icon="store" data-quick-static><span><Icon name="store" size={25} /></span><b>خرید عمده</b></a>
  </nav>
  <div class="mobile-quick-links-spacer" aria-hidden="true"></div>

  <div class="mobile-store-tools">
    <a class="mobile-notification" href="/contact/" aria-label="ارتباط با پشتیبانی"><Icon name="bell" size={22} /></a>
    <form class="mobile-search" action="/products/" method="get" role="search" data-mobile-product-search>
      <Icon name="search" size={22} />
      <input name="q" type="search" placeholder="جست‌وجوی نام محصول" aria-label="جست‌وجوی محصولات" autocomplete="off" aria-controls="mobile-product-search-results" aria-expanded="false" data-mobile-product-search-input />
      <div class="mobile-search-results" id="mobile-product-search-results" data-mobile-product-search-results hidden aria-live="polite"></div>
    </form>
  </div>

  <a class="mobile-delivery-link" href="/account/addresses/">
    <Icon name="address" size={20} />
    <span>انتخاب آدرس و روش دریافت</span>
    <b>⌄</b>
  </a>
</section>

<script>
  import "../scripts/mobile-category-dock.ts";
  import "../scripts/mobile-product-search.ts";
</script>
