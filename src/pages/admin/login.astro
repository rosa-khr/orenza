---
import "../../styles/admin.css";
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" />
    <title>ورود مدیریت | اورنزا</title>
  </head>
  <body class="admin-login-body">
    <main class="admin-login">
      <a class="admin-login-brand" href="/" aria-label="بازگشت به فروشگاه اورنزا"><span>O</span><strong>ORENZA</strong></a>
      <div class="admin-login-atmosphere" aria-hidden="true">
        <span>ORENZA MANAGEMENT</span>
        <strong>کنترل ساده‌تر،<br />مدیریت دقیق‌تر.</strong>
        <small>دسترسی امن به فضای مدیریت فروشگاه</small>
      </div>
      <form data-admin-login novalidate>
        <span>MANAGEMENT ACCESS</span>
        <h1>ورود به مدیریت</h1>
        <p>با حساب مدیر اورنزا وارد شوید.</p>
        <label><span>نام کاربری</span><input name="username" dir="ltr" autocomplete="username" minlength="3" required /></label>
        <label><span>رمز عبور</span><input name="password" type="password" autocomplete="current-password" minlength="8" required /></label>
        <small data-login-error aria-live="polite"></small>
        <button type="submit">ورود به پنل</button>
      </form>
    </main>
    <script>
      import "../../scripts/logger.ts";
    </script>
    <script>
      import "../../scripts/admin.ts";
    </script>
  </body>
</html>
