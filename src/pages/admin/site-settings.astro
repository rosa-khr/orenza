---
import { GripVertical, ImagePlus, Plus, Save, ScrollText, Trash2, Upload } from "@lucide/astro";
import AdminShell from "../../components/admin/AdminShell.astro";
---

<AdminShell
  title="تنظیمات سایت"
  description="اطلاعات عمومی، هویت بصری، سئو و وضعیت ایندکس فروشگاه"
  active="site-settings"
  actionLabel="تنظیمات"
>
  <a class="admin-secondary-action" href="/admin/service-scripts/list/" slot="heading-action">
    <ScrollText size={17} stroke-width={1.5} /> اسکریپت‌های سرویس
  </a>

  <form class="admin-site-settings" data-admin-site-settings novalidate>
    <nav class="admin-settings-menu" data-settings-menu aria-label="منوی تنظیمات سایت">
      <button type="button" data-settings-group-target="general">تنظیمات کلی</button>
      <button type="button" data-settings-group-target="homepage">هوم‌پیج</button>
      <button type="button" data-settings-group-target="banners">بنرها</button>
      <button type="button" data-settings-group-target="invoice">فاکتور</button>
    </nav>

    <section class="admin-card" data-settings-group="general">
      <header><span>GENERAL SETTINGS</span><h2>اطلاعات عمومی</h2><p>اطلاعاتی که در هویت برند و راه‌های ارتباطی نمایش داده می‌شود.</p></header>
      <div class="admin-form-grid">
        <label class="admin-field"><span>نام فارسی برند</span><input name="brandName" required minlength="2" /></label>
        <label class="admin-field"><span>نام انگلیسی برند</span><input name="brandNameEn" required minlength="2" dir="ltr" /></label>
        <label class="admin-field wide"><span>شعار کوتاه</span><input name="brandTagline" required minlength="3" /></label>
        <label class="admin-field"><span>شماره تماس</span><input name="supportPhone" required dir="ltr" /></label>
        <label class="admin-field"><span>ایمیل پشتیبانی</span><input name="supportEmail" type="email" required dir="ltr" /></label>
        <label class="admin-field"><span>لینک واتساپ</span><input name="whatsappUrl" type="url" required dir="ltr" /></label>
        <label class="admin-field"><span>لینک بله</span><input name="baleUrl" type="url" required dir="ltr" /></label>
        <label class="admin-field"><span>لینک اینستاگرام</span><input name="instagramUrl" type="url" required dir="ltr" /></label>
        <label class="admin-field"><span>آدرس وب‌سایت</span><input name="websiteUrl" type="url" required dir="ltr" value="https://orenza.ir" /></label>
        <label class="admin-field wide"><span>نشانی مجموعه</span><textarea name="address"></textarea></label>
      </div>
    </section>

    <section class="admin-card" data-settings-group="general">
      <header><span>BRANDING & FOOTER</span><h2>هویت بصری و فوتر</h2><p>لوگو، favicon و متن‌های ثابت پایین صفحات.</p></header>
      <div class="admin-form-grid">
        <label class="admin-field"><span>آدرس لوگو</span><input name="logoUrl" type="url" dir="ltr" placeholder="https://... یا خالی" /></label>
        <label class="admin-field"><span>آدرس favicon</span><input name="faviconUrl" required dir="ltr" /></label>
        <label class="admin-field wide"><span>عنوان ارتباط با ما در فوتر</span><input name="footerHeading" required /></label>
        <label class="admin-field wide"><span>متن راهنمای فوتر</span><textarea name="footerDescription" required></textarea></label>
        <label class="admin-field wide"><span>متن کپی‌رایت</span><input name="footerCopyright" required /></label>
      </div>
    </section>

    <section class="admin-card" data-settings-group="invoice">
      <header><span>OFFICIAL INVOICE</span><h2>اطلاعات فاکتور رسمی</h2><p>شناسه ملی و امضای فروشنده در تمام نسخه‌های چاپی فاکتور نمایش داده می‌شود.</p></header>
      <div class="admin-form-grid">
        <label class="admin-field">
          <span>شناسه ملی فروشنده</span>
          <input name="invoiceNationalId" required minlength="10" maxlength="20" inputmode="numeric" value="۰۰۲۱۴۱۱۴۱۷" />
        </label>
        <div class="admin-signature-setting wide" data-invoice-signature-setting>
          <div class="admin-signature-preview">
            <img data-invoice-signature-preview hidden alt="پیش‌نمایش امضای فروشنده" />
            <span data-invoice-signature-placeholder>هنوز تصویری برای امضا ثبت نشده است.</span>
          </div>
          <div>
            <strong>تصویر امضای فروشنده</strong>
            <small>ترجیحاً PNG با پس‌زمینه شفاف؛ JPG، PNG یا WebP تا ۵ مگابایت</small>
            <div class="admin-signature-actions">
              <label>
                <Upload size={16} stroke-width={1.5} />
                انتخاب و بارگذاری امضا
                <input type="file" name="invoiceSignature" accept="image/jpeg,image/png,image/webp" data-invoice-signature-input />
              </label>
              <button type="button" data-invoice-signature-remove hidden>
                <Trash2 size={15} stroke-width={1.5} /> حذف امضا
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="admin-card" data-settings-group="banners">
      <header><span>HOMEPAGE BANNERS</span><h2>بنر صفحه اصلی</h2><p>برای نمایش بهتر در هر دستگاه، بنر دسکتاپ و موبایل را جداگانه بارگذاری کنید.</p></header>
      <div class="admin-banner-guidance">
        <strong>راهنمای آماده‌سازی بنر</strong>
        <span>دسکتاپ: <b dir="ltr">1920 × 820 px</b> · موبایل: <b dir="ltr">900 × 1200 px</b></span>
        <small>فرمت پیشنهادی WebP، حجم ترجیحاً کمتر از ۵ مگابایت. متن و سوژه اصلی را نزدیک مرکز تصویر نگه دارید تا در برش‌های مختلف دیده شوند.</small>
      </div>
      <div class="admin-homepage-banners">
        <div class="admin-banner-setting" data-homepage-banner-setting="desktop">
          <div class="admin-banner-preview">
            <img data-homepage-banner-preview hidden alt="پیش‌نمایش بنر دسکتاپ صفحه اصلی" />
            <span data-homepage-banner-placeholder>بنر دسکتاپ ثبت نشده است.</span>
          </div>
          <div>
            <strong>بنر دسکتاپ</strong>
            <small>ابعاد پیشنهادی: ۱۹۲۰ در ۸۲۰ پیکسل</small>
            <label class="admin-upload-button">
              <Upload size={16} stroke-width={1.5} /> انتخاب بنر دسکتاپ
              <input type="file" accept="image/jpeg,image/png,image/webp" data-homepage-banner-input />
            </label>
            <button type="button" class="admin-remove-banner" data-homepage-banner-remove hidden><Trash2 size={15} stroke-width={1.5} /> حذف بنر</button>
          </div>
        </div>
        <div class="admin-banner-setting" data-homepage-banner-setting="mobile">
          <div class="admin-banner-preview">
            <img data-homepage-banner-preview hidden alt="پیش‌نمایش بنر موبایل صفحه اصلی" />
            <span data-homepage-banner-placeholder>بنر موبایل ثبت نشده است.</span>
          </div>
          <div>
            <strong>بنر موبایل</strong>
            <small>ابعاد پیشنهادی: ۹۰۰ در ۱۲۰۰ پیکسل</small>
            <label class="admin-upload-button">
              <Upload size={16} stroke-width={1.5} /> انتخاب بنر موبایل
              <input type="file" accept="image/jpeg,image/png,image/webp" data-homepage-banner-input />
            </label>
            <button type="button" class="admin-remove-banner" data-homepage-banner-remove hidden><Trash2 size={15} stroke-width={1.5} /> حذف بنر</button>
          </div>
        </div>
      </div>
    </section>

    <section class="admin-card" data-settings-group="banners">
      <header><span>HOMEPAGE BANNER ROWS</span><h2>ردیف‌های بنر صفحه اصلی</h2><p>دو ردیف بنر قابل مدیریت برای نمایش قبل از بخش‌های شگفت‌انگیزها و پرطرفدارها.</p></header>
      <div class="admin-banner-guidance">
        <strong>چینش بنرها</strong>
        <span>در دسکتاپ هر ردیف می‌تواند ۱، ۲، ۳ یا ۴ ستون داشته باشد؛ در موبایل همیشه دو بنر در هر ردیف نمایش داده می‌شود.</span>
        <small>اگر فقط یک بنر فعال باشد، همان بنر کل عرض ردیف را می‌گیرد. برای تغییر ترتیب، کارت بنر را بکشید و جابه‌جا کنید.</small>
        <div class="admin-banner-size-guide">
          <b>ابعاد پیشنهادی آپلود</b>
          <span>۱ بنر در ردیف: <strong dir="ltr">1920 × 520 px</strong></span>
          <span>۲ ستون: <strong dir="ltr">940 × 520 px</strong></span>
          <span>۳ ستون: <strong dir="ltr">620 × 520 px</strong></span>
          <span>۴ ستون: <strong dir="ltr">460 × 520 px</strong></span>
          <span>موبایل: <strong dir="ltr">720 × 520 px</strong> یا بزرگ‌تر</span>
        </div>
      </div>
      <div class="admin-home-banner-rows">
        <article class="admin-home-banner-row" data-home-banner-row-editor="aboveDiscount">
          <header>
            <div><strong>بالای شگفت‌انگیزها</strong><small>این ردیف قبل از بخش محصولات شگفت‌انگیز نمایش داده می‌شود.</small></div>
            <label class="admin-switch"><input type="checkbox" data-home-banner-row-active /><span></span> نمایش ردیف</label>
          </header>
          <div class="admin-banner-row-controls">
            <label class="admin-field"><span>تعداد ستون دسکتاپ</span><select data-home-banner-row-columns><option value="1">۱ ستون</option><option value="2">۲ ستون</option><option value="3">۳ ستون</option><option value="4">۴ ستون</option></select></label>
            <button type="button" data-home-banner-add-item><Plus size={15} stroke-width={1.6} /> افزودن بنر</button>
          </div>
          <div class="admin-home-banner-items" data-home-banner-items></div>
        </article>
        <article class="admin-home-banner-row" data-home-banner-row-editor="aboveBest">
          <header>
            <div><strong>بالای پرطرفدارها</strong><small>این ردیف قبل از بخش پرفروش‌ترین‌ها/پرطرفدارها نمایش داده می‌شود.</small></div>
            <label class="admin-switch"><input type="checkbox" data-home-banner-row-active /><span></span> نمایش ردیف</label>
          </header>
          <div class="admin-banner-row-controls">
            <label class="admin-field"><span>تعداد ستون دسکتاپ</span><select data-home-banner-row-columns><option value="1">۱ ستون</option><option value="2">۲ ستون</option><option value="3">۳ ستون</option><option value="4">۴ ستون</option></select></label>
            <button type="button" data-home-banner-add-item><Plus size={15} stroke-width={1.6} /> افزودن بنر</button>
          </div>
          <div class="admin-home-banner-items" data-home-banner-items></div>
        </article>
      </div>
      <template data-home-banner-item-template>
        <article class="admin-home-banner-item" draggable="true" data-home-banner-item>
          <button type="button" class="admin-banner-drag" data-home-banner-drag aria-label="جابجایی بنر"><GripVertical size={16} stroke-width={1.6} /></button>
          <div class="admin-banner-preview">
            <img data-home-banner-item-preview hidden alt="پیش‌نمایش بنر" />
            <span data-home-banner-item-placeholder>تصویر بنر انتخاب نشده است.</span>
          </div>
          <div class="admin-home-banner-item-fields">
            <div class="admin-home-banner-item-top">
              <label class="admin-switch"><input type="checkbox" data-home-banner-item-active /><span></span> نمایش بنر</label>
              <button type="button" class="admin-remove-banner" data-home-banner-remove-item><Trash2 size={15} stroke-width={1.5} /> حذف</button>
            </div>
            <label class="admin-field"><span>متن جایگزین</span><input data-home-banner-item-alt /></label>
            <label class="admin-field"><span>لینک بنر</span><input data-home-banner-item-href dir="ltr" placeholder="/products/ یا https://..." /></label>
            <label class="admin-field"><span>عنوان SEO بنر</span><input data-home-banner-item-seo-title maxlength="160" /></label>
            <label class="admin-field"><span>هدف IEO</span><input data-home-banner-item-ieo-intent maxlength="160" placeholder="مثلاً خرید قهوه اسپرسو تازه" /></label>
            <label class="admin-field"><span>توضیح SEO بنر</span><textarea data-home-banner-item-seo-description maxlength="320"></textarea></label>
            <label class="admin-field"><span>خلاصه GEO</span><textarea data-home-banner-item-geo-summary maxlength="500" placeholder="متن قابل فهم برای پاسخ‌های جست‌وجوی مولد"></textarea></label>
            <label class="admin-upload-button">
              <ImagePlus size={16} stroke-width={1.5} /> بارگذاری تصویر
              <input type="file" accept="image/jpeg,image/png,image/webp" data-home-banner-item-input />
            </label>
          </div>
        </article>
      </template>
    </section>

    <section class="admin-card admin-indexing-setting" data-settings-group="homepage">
      <header><span>HOMEPAGE PRODUCT RAILS</span><h2>نمایش نوارهای محصول صفحه اصلی</h2><p>نمایش یا عدم نمایش نوارهای پرطرفدارها و شگفت‌انگیزها در صفحه اول.</p></header>
      <label>
        <input type="checkbox" name="homepageBestSellersEnabled" />
        <span><strong>نوار پرطرفدارها نمایش داده شود</strong><small>اگر خاموش باشد، کل بخش پرطرفدارها در صفحه اصلی مخفی می‌شود.</small></span>
      </label>
      <label>
        <input type="checkbox" name="homepageDiscountsEnabled" />
        <span><strong>نوار شگفت‌انگیزها نمایش داده شود</strong><small>اگر خاموش باشد، کل بخش تخفیف‌دارها در صفحه اصلی مخفی می‌شود.</small></span>
      </label>
    </section>

    <section class="admin-card" data-settings-group="homepage">
      <header><span>HOMEPAGE SEO</span><h2>سئوی صفحه اصلی</h2><p>عنوان و توضیحات اصلی نتایج جست‌وجو و اشتراک‌گذاری اجتماعی.</p></header>
      <div class="admin-form-grid">
        <label class="admin-field wide"><span>عنوان SEO</span><input name="homepageSeoTitle" required minlength="10" maxlength="220" /></label>
        <label class="admin-field wide"><span>توضیحات Meta</span><textarea name="homepageSeoDescription" required minlength="30" maxlength="500"></textarea></label>
        <label class="admin-field wide"><span>کلمات کلیدی، جداشده با ویرگول</span><textarea name="homepageSeoKeywords" required></textarea></label>
        <label class="admin-field wide"><span>تصویر Open Graph</span><input name="homepageOgImageUrl" required dir="ltr" /></label>
      </div>
    </section>

    <section class="admin-card" data-settings-group="general">
      <header><span>AI CONTENT GENERATION</span><h2>تنظیمات تولید محتوا</h2><p>کلید سرویس برای تولید محتوا و تحلیل تصویر کلمات کلیدی؛ کلید به‌صورت رمزنگاری‌شده ذخیره می‌شود.</p></header>
      <div class="admin-form-grid">
        <label class="admin-field"><span>مدل OpenAI</span><select name="contentAiModel" required><option value="gpt-5.6-sol">GPT-5.6 Sol</option><option value="gpt-5.5">GPT-5.5 (با reasoning متوسط)</option><option value="gpt-5.4">GPT-5.4</option><option value="gpt-5.1">GPT-5.1</option><option value="gpt-5">GPT-5</option><option value="gpt-5-mini">GPT-5 mini</option><option value="gpt-5-nano">GPT-5 nano</option><option value="gpt-4.1">GPT-4.1</option><option value="gpt-4.1-mini">GPT-4.1 mini</option><option value="gpt-4.1-nano">GPT-4.1 nano</option><option value="o3">o3</option><option value="o4-mini">o4-mini</option></select></label>
        <label class="admin-field"><span>کلید API</span><input name="contentAiApiKey" type="password" placeholder="برای حفظ کلید فعلی خالی بگذارید" dir="ltr" autocomplete="new-password" /></label>
        <label class="admin-field wide"><span>دستور پایه تولید محتوا</span><textarea name="contentAiInstructions" required minlength="20" maxlength="3000"></textarea></label>
        <label class="admin-field"><span>مخاطب پیش‌فرض</span><input name="contentAiDefaultAudience" required /></label>
        <label class="admin-field"><span>لحن پیش‌فرض</span><input name="contentAiDefaultTone" required /></label>
        <label class="admin-field"><span>طول پیش‌فرض</span><select name="contentAiDefaultLength"><option value="short">کوتاه</option><option value="medium">متوسط</option><option value="long">کامل</option></select></label>
        <label class="admin-field"><span>زبان پیش‌فرض</span><select name="contentAiDefaultLanguage"><option value="fa">فارسی</option><option value="en">English</option></select></label>
        <small class="admin-field wide admin-ai-key-state" data-ai-key-state>در حال بررسی وضعیت کلید…</small>
      </div>
    </section>

    <section class="admin-card admin-indexing-setting" data-settings-group="general">
      <header><span>SEARCH ENGINE INDEXING</span><h2>دسترسی موتورهای جست‌وجو</h2><p>غیرفعال‌کردن این گزینه، robots.txt و هدر noindex را هم‌زمان فعال می‌کند.</p></header>
      <label>
        <input type="checkbox" name="searchIndexingEnabled" />
        <span><strong>ایندکس سایت فعال باشد</strong><small>برای سایت منتشرشده روشن بماند؛ در محیط آزمایشی خاموشش کنید.</small></span>
      </label>
    </section>

    <footer class="admin-site-settings-actions">
      <small data-site-settings-state>در حال دریافت تنظیمات…</small>
      <button type="submit"><Save size={17} stroke-width={1.45} /> ذخیره تنظیمات</button>
    </footer>
  </form>
</AdminShell>
