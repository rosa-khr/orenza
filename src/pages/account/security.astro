---
import AccountShell from "../../components/AccountShell.astro";
import Icon from "../../components/Icon.astro";

const next = Astro.url.searchParams.get("next");
const safeNext = next?.startsWith("/") && !next.startsWith("//") ? next : "";
const cartReturnHref = safeNext.startsWith("/order/") ? safeNext : "/order/?cart=open";
---

<AccountShell title="امنیت حساب" current="security">
  <section class="account-panel account-route-panel account-security-panel">
    <header><span>03</span><div><h2>امنیت حساب</h2><p>رمز جدید باید حداقل ۸ کاراکتر داشته باشد.</p></div></header>
    <form class="account-form account-security-form" data-password-form novalidate>
      <label data-current-password><span>رمز عبور فعلی</span><input name="currentPassword" type="password" autocomplete="current-password" /></label>
      <label><span>رمز عبور جدید</span><input name="newPassword" type="password" autocomplete="new-password" minlength="8" required /></label>
      <label><span>تکرار رمز عبور جدید</span><input name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required /></label>
      <div class="account-form-actions">
        <button class="account-primary" type="submit">ثبت رمز عبور جدید</button>
        <a class="account-cart-return" href={cartReturnHref}>
          <Icon name="cart" size={17} />
          بازگشت به سبد خرید
        </a>
      </div>
      <p class="account-status" data-password-status aria-live="polite"></p>
    </form>
  </section>
</AccountShell>
