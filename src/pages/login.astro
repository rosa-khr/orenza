---
import BaseLayout from "../layouts/BaseLayout.astro";

const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || "";
---

<BaseLayout
  title="ورود به حساب کاربری"
  description="ورود یا ساخت حساب کاربری اورنزا."
  canonicalPath="/login/"
  keywords={[]}
  noindex
>
  <section class="auth-page">
    <div class="auth-intro">
      <p class="eyebrow">حساب کاربری اورنزا</p>
      <h1>ورود سریع،<br />خرید ساده‌تر.</h1>
      <p>برای ذخیره نشانی‌ها و مدیریت سفارش‌ها، با شماره موبایل وارد شوید یا در چند ثانیه حساب بسازید.</p>
    </div>

    <div class="auth-card" data-auth-card data-google-client-id={googleClientId}>
      <div class="auth-mode" role="tablist" aria-label="نوع ورود">
        <button type="button" role="tab" aria-selected="true" data-auth-mode="login">ورود به حساب</button>
        <button type="button" role="tab" aria-selected="false" data-auth-mode="register">ایجاد حساب</button>
      </div>

      <form data-auth-form novalidate>
        <label data-name-field hidden>
          <span>نام و نام خانوادگی</span>
          <input name="displayName" autocomplete="name" minlength="2" placeholder="مثلاً زهرا احمدی" />
        </label>
        <label>
          <span>شماره موبایل</span>
          <input name="phone" type="tel" autocomplete="tel" inputmode="numeric" pattern="09[0-9]{9}" placeholder="09xxxxxxxxx" required />
        </label>
        <label>
          <span>رمز عبور</span>
          <input name="password" type="password" autocomplete="current-password" minlength="8" placeholder="حداقل ۸ کاراکتر" required />
        </label>
        <button class="auth-help" type="button" data-show-reset>رمز عبورم را فراموش کرده‌ام</button>
        <button class="account-primary" type="submit" data-auth-submit>ورود و ادامه</button>
      </form>

      <section class="password-reset" data-reset-panel hidden>
        <div class="password-reset-heading">
          <div>
            <strong>بازیابی رمز عبور</strong>
            <small>کد شش‌رقمی به شماره ثبت‌شده ارسال می‌شود.</small>
          </div>
          <button type="button" data-hide-reset>بازگشت به ورود</button>
        </div>
        <form data-reset-request novalidate>
          <label>
            <span>شماره موبایل</span>
            <input name="phone" type="tel" autocomplete="tel" inputmode="numeric" pattern="09[0-9]{9}" placeholder="09xxxxxxxxx" required />
          </label>
          <button class="account-primary" type="submit">ارسال کد بازیابی</button>
        </form>
        <form data-reset-confirm hidden novalidate>
          <label>
            <span>کد بازیابی</span>
            <input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="کد ۶ رقمی" required />
          </label>
          <label>
            <span>رمز عبور تازه</span>
            <input name="newPassword" type="password" autocomplete="new-password" minlength="8" placeholder="حداقل ۸ کاراکتر" required />
          </label>
          <label>
            <span>تکرار رمز عبور تازه</span>
            <input name="confirmPassword" type="password" autocomplete="new-password" minlength="8" placeholder="رمز تازه را دوباره وارد کنید" required />
          </label>
          <button class="account-primary" type="submit">ثبت رمز عبور تازه</button>
        </form>
      </section>

      <div class="auth-google" data-auth-google>
        <div class="auth-divider"><span>یا</span></div>
        {googleClientId ? (
          <div class="google-login" data-google-login aria-label="ورود با حساب گوگل"></div>
        ) : (
          <button class="google-login" type="button" data-google-unconfigured>
            <svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.4a4.6 4.6 0 0 1-2 3v2.5h3.3c1.9-1.8 2.9-4.3 2.9-7.4Z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.7-2.4l-3.3-2.5c-.9.6-2.1 1-3.4 1a5.9 5.9 0 0 1-5.5-4.1H3.1v2.6A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.5 14a6 6 0 0 1 0-3.9V7.4H3.1a10 10 0 0 0 0 9.2L6.5 14Z"/><path fill="#EA4335" d="M12 6a5.4 5.4 0 0 1 3.8 1.5l2.9-2.8A9.7 9.7 0 0 0 3.1 7.4l3.4 2.7A5.9 5.9 0 0 1 12 6Z"/></svg>
            <span>ورود با حساب گوگل</span>
          </button>
        )}
      </div>
      <p class="account-status" data-auth-status aria-live="polite"></p>
    </div>
  </section>
  <script>
    import "../scripts/auth.ts";
  </script>
</BaseLayout>
