---
import BaseLayout from "../layouts/BaseLayout.astro";

const defaultTerms = `<p>با ثبت سفارش در فروشگاه اورنزا، کاربر تأیید می‌کند اطلاعات سفارش و نشانی تحویل را به‌درستی وارد کرده است.</p>
<p>قیمت، موجودی و شرایط ارسال کالاها مطابق اطلاعات نمایش‌داده‌شده در زمان ثبت سفارش محاسبه می‌شود. در صورت بروز خطا یا تغییر ضروری، پشتیبانی اورنزا برای هماهنگی با خریدار تماس خواهد گرفت.</p>
<p>اطلاعات شخصی کاربران فقط برای پردازش سفارش، ارسال کالا و ارائه خدمات پشتیبانی استفاده می‌شود و بدون مجوز قانونی در اختیار اشخاص دیگر قرار نمی‌گیرد.</p>
<p>شرایط مرجوعی یا لغو سفارش با توجه به نوع محصول، وضعیت بسته‌بندی و مرحله آماده‌سازی بررسی می‌شود. برای پیگیری هر درخواست با پشتیبانی اورنزا تماس بگیرید.</p>`;
---

<BaseLayout
  title="قوانین و شرایط استفاده"
  description="قوانین ثبت سفارش، ارسال، حفظ اطلاعات کاربران و شرایط استفاده از فروشگاه اینترنتی قهوه اورنزا."
  canonicalPath="/terms/"
  keywords={["قوانین فروشگاه اورنزا", "شرایط ثبت سفارش قهوه", "قوانین خرید اینترنتی"]}
  pageType="article"
>
  <main class="terms-page">
    <header>
      <span>TERMS & CONDITIONS</span>
      <h1>قوانین و شرایط استفاده</h1>
      <p>چارچوب ثبت سفارش و استفاده از خدمات فروشگاه اورنزا</p>
    </header>
    <article data-site-terms-content set:html={defaultTerms}></article>
  </main>
</BaseLayout>
