---
import "../styles/global.css";
import "../styles/luxury.css";

const blends = [
  { id: "r100", title: "۱۰۰٪ روبوستا", note: "قوی، تلخ و پرکافئین", robusta: 100 },
  { id: "r90", title: "۹۰٪ روبوستا", note: "انرژی بالا با عطر متعادل", robusta: 90 },
  { id: "r80", title: "۸۰٪ روبوستا", note: "کِرمای زیاد و طعم ماندگار", robusta: 80 },
  { id: "r70", title: "۷۰٪ روبوستا", note: "قدرت و عطر در یک تعادل", robusta: 70 },
  { id: "half", title: "۵۰٪ روبوستا · ۵۰٪ عربیکا", note: "متعادل و همه‌پسند", robusta: 50 },
  { id: "a70", title: "۷۰٪ عربیکا", note: "معطر، نرم و خوش‌طعم", robusta: 30 },
  { id: "a100", title: "۱۰۰٪ عربیکا", note: "عطر پیچیده و اسیدیته دلنشین", robusta: 0 }
];

const roasts = [
  { id: "light", title: "روشن", note: "عطر بیشتر، اسیدیته زنده" },
  { id: "medium", title: "متوسط", note: "متعادل و شیرین" },
  { id: "dark", title: "تیره", note: "تلخی عمیق، بدنه سنگین" }
];

const devices = [
  { id: "espresso", title: "اسپرسوساز", icon: "espresso" },
  { id: "moka", title: "موکاپات", icon: "moka" },
  { id: "filter", title: "قهوه دمی", icon: "filter" },
  { id: "french", title: "فرنچ‌پرس", icon: "french" },
  { id: "turkish", title: "قهوه ترک", icon: "turkish" }
];

const weights = ["۲۵۰ گرم", "۵۰۰ گرم", "۱ کیلوگرم", "عمده"];

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Orenza Coffee",
  alternateName: "قهوه اورنزا",
  url: "https://orenza.ir",
  email: "order.orenzacoffee@gmail.com",
  telephone: "+989103060396",
  sameAs: [
    "https://instagram.com/orenzacoffee",
    "https://t.me/orenzacoffee"
  ]
};
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#11110f" />
    <meta name="description" content="قهوه تازه رست اورنزا؛ ترکیب، درجه رست و آسیاب مناسب دستگاهت را انتخاب کن و قهوه‌ای دقیقاً مطابق سلیقه‌ات بساز." />
    <meta name="keywords" content="خرید قهوه تازه رست، قهوه اسپرسو، قهوه عربیکا، قهوه روبوستا، آسیاب قهوه، قهوه اورنزا" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:site_name" content="Orenza Coffee" />
    <meta property="og:title" content="Orenza Coffee | قهوه، آن‌طور که تو می‌پسندی" />
    <meta property="og:description" content="ترکیب، رست و آسیاب قهوه‌ات را خودت انتخاب کن. تازه‌رست و آماده برای لحظه تو." />
    <meta property="og:url" content="https://orenza.ir/" />
    <link rel="canonical" href="https://orenza.ir/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    <title>خرید قهوه تازه رست | Orenza Coffee</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="اورنزا، صفحه اصلی">
        <span class="brand-mark" aria-hidden="true">O</span>
        <span class="brand-name">ORENZA</span>
      </a>
      <nav aria-label="ناوبری اصلی">
        <a href="#story">داستان ما</a>
        <a href="#coffee-builder">ساخت قهوه</a>
        <a href="#contact">ارتباط</a>
      </nav>
      <a class="header-cta" href="#coffee-builder">قهوه‌ات را بساز</a>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">ORENZA · قهوه تازه‌رست</p>
          <h1 id="hero-title">یک فنجان،<br /><em>برای لحظه‌های</em><br />خوبِ تو.</h1>
          <p class="hero-lead">ترکیب، رست و آسیاب را تو انتخاب می‌کنی؛ ما قهوه‌ای تازه و دقیق برای آیین روزانه‌ات آماده می‌کنیم.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#coffee-builder">قهوه‌ام را می‌سازم <span aria-hidden="true">←</span></a>
            <a class="text-link" href="#story">داستان اورنزا</a>
          </div>
          <div class="fresh-note">
            <span class="fresh-dot"></span>
              <span><strong>تازه، برای شما</strong><small>رست و آماده‌سازی پس از انتخاب</small></span>
          </div>
        </div>

        <div class="hero-product" aria-label="پاکت قهوه مشکی اورنزا">
          <div class="halo"></div>
          <div class="coffee-bean bean-one"></div>
          <div class="coffee-bean bean-two"></div>
          <div class="coffee-bean bean-three"></div>
          <div class="bag-wrap">
            <div class="bag-shadow"></div>
            <div class="coffee-bag">
              <div class="bag-fold"></div>
              <span class="bag-origin">ROASTED WITH INTENTION</span>
              <div class="bag-logo">
                <span>O</span>
                <strong>ORENZA</strong>
                <small>COFFEE ROASTERS</small>
              </div>
              <div class="bag-label">
                <small>YOUR DAILY RITUAL</small>
                <span>ترکیب ویژه شما</span>
              </div>
              <div class="bag-weight">250 g</div>
            </div>
          </div>
          <span class="vertical-note">CRAFTED FOR YOUR MOMENT</span>
        </div>

        <a class="scroll-cue" href="#story"><span>اسکرول</span><i></i></a>
      </section>

      <section class="manifesto" id="story" aria-labelledby="story-title">
        <div class="section-number">01</div>
        <div class="manifesto-copy">
          <p class="eyebrow">فلسفه اورنزا</p>
          <h2 id="story-title">یک فنجان خوب،<br />از یک انتخاب خوب شروع می‌شود.</h2>
        </div>
        <div class="manifesto-body">
          <p>ما قهوه را از قبل برای همه یکسان نمی‌سازیم. تو طعم، قدرت، رست و روش دم‌آوری را انتخاب می‌کنی؛ ما همان انتخاب را تازه آماده می‌کنیم.</p>
          <div class="value-row">
            <span><b>01</b> تازه‌رست</span>
            <span><b>02</b> انتخاب شخصی</span>
            <span><b>03</b> آسیاب دقیق</span>
          </div>
        </div>
      </section>

      <section class="builder-section" id="coffee-builder" aria-labelledby="builder-title">
        <header class="builder-header">
          <div>
            <p class="eyebrow">YOUR COFFEE · YOUR WAY</p>
            <h2 id="builder-title">قهوه‌ات را بساز.</h2>
          </div>
          <p>پنج انتخاب کوتاه تا ترکیبی که برای تو ساخته شده.</p>
        </header>

        <div class="builder-shell" data-builder>
          <div class="builder-progress" aria-label="پیشرفت انتخاب قهوه">
            <span class="progress-line"><i data-progress-line></i></span>
            <button class="is-active" data-step-jump="1"><b>۱</b><span>ترکیب</span></button>
            <button data-step-jump="2" disabled><b>۲</b><span>رست</span></button>
            <button data-step-jump="3" disabled><b>۳</b><span>آسیاب</span></button>
            <button data-step-jump="4" disabled><b>۴</b><span>وزن</span></button>
            <button data-step-jump="5" disabled><b>۵</b><span>نتیجه</span></button>
          </div>

          <div class="builder-main">
            <div class="builder-steps">
              <section class="builder-step is-active" data-step="1">
                <span class="step-kicker">مرحله اول</span>
                <h3>چه ترکیبی دوست داری؟</h3>
                <p class="step-help">روبوستای بیشتر یعنی قدرت و کافئین بیشتر؛ عربیکای بیشتر یعنی عطر و لطافت بیشتر.</p>
                <div class="choice-grid blend-grid">
                  {blends.map((blend, index) => (
                    <button class="choice-card" data-choice="blend" data-value={blend.title} data-robusta={blend.robusta}>
                      <span class="choice-check"></span>
                      <strong>{blend.title}</strong>
                      <small>{blend.note}</small>
                      <span class="blend-meter" aria-hidden="true">
                        <i style={`--fill: ${blend.robusta}%`}></i>
                      </span>
                      <em>{index === 4 ? "تعادل" : blend.robusta >= 70 ? "قدرت" : "عطر"}</em>
                    </button>
                  ))}
                </div>
              </section>

              <section class="builder-step" data-step="2">
                <span class="step-kicker">مرحله دوم</span>
                <h3>رست قهوه چقدر باشد؟</h3>
                <p class="step-help">درجه رست، عطر و تلخی فنجان را شکل می‌دهد.</p>
                <div class="choice-grid roast-grid">
                  {roasts.map((roast, index) => (
                    <button class="choice-card roast-card" data-choice="roast" data-value={roast.title}>
                      <span class="choice-check"></span>
                      <span class={`roast-bean roast-${index + 1}`} aria-hidden="true"></span>
                      <strong>رست {roast.title}</strong>
                      <small>{roast.note}</small>
                    </button>
                  ))}
                </div>
              </section>

              <section class="builder-step" data-step="3">
                <span class="step-kicker">مرحله سوم</span>
                <h3>دان یا آسیاب‌شده؟</h3>
                <p class="step-help">اگر آسیاب‌شده می‌خواهی، دستگاهت را هم انتخاب کن تا درجه آسیاب دقیق باشد.</p>
                <div class="choice-grid grind-type-grid">
                  <button class="choice-card large-choice" data-choice="grind" data-value="دان کامل">
                    <span class="choice-check"></span>
                    <span class="whole-beans" aria-hidden="true"><i></i><i></i><i></i></span>
                    <strong>دان کامل</strong>
                    <small>برای آسیاب‌کردن در لحظه</small>
                  </button>
                  <button class="choice-card large-choice" data-choice="grind" data-value="آسیاب‌شده" data-reveals-devices>
                    <span class="choice-check"></span>
                    <span class="ground-coffee" aria-hidden="true"></span>
                    <strong>آسیاب‌شده</strong>
                    <small>دقیق و متناسب با دستگاه شما</small>
                  </button>
                </div>
                <div class="device-picker" data-device-picker hidden>
                  <h4>برای کدام دستگاه؟</h4>
                  <div class="device-grid">
                    {devices.map((device) => (
                      <button class="device-card" data-choice="device" data-value={device.title}>
                        <span class={`device-icon device-${device.icon}`} aria-hidden="true"></span>
                        <strong>{device.title}</strong>
                      </button>
                    ))}
                  </div>
                </div>
              </section>

              <section class="builder-step" data-step="4">
                <span class="step-kicker">مرحله چهارم</span>
                <h3>چه وزنی برایت مناسب است؟</h3>
                <p class="step-help">برای مصرف روزانه، ۲۵۰ یا ۵۰۰ گرم انتخاب خوبی است.</p>
                <div class="choice-grid weight-grid">
                  {weights.map((weight) => (
                    <button class="choice-card weight-card" data-choice="weight" data-value={weight}>
                      <span class="choice-check"></span>
                      <strong>{weight}</strong>
                    </button>
                  ))}
                </div>
              </section>

              <section class="builder-step result-step" data-step="5">
                <span class="step-kicker">انتخاب تو</span>
                <h3>این قهوه برای تو ساخته شده.</h3>
                <p class="step-help">در مرحله بعد فروشگاه، قیمت و ثبت سفارش به این بخش اضافه می‌شود.</p>
                <dl class="result-list">
                  <div><dt>ترکیب</dt><dd data-result="blend">—</dd></div>
                  <div><dt>درجه رست</dt><dd data-result="roast">—</dd></div>
                  <div><dt>نوع</dt><dd data-result="grind">—</dd></div>
                  <div data-device-result hidden><dt>دستگاه</dt><dd data-result="device">—</dd></div>
                  <div><dt>وزن</dt><dd data-result="weight">—</dd></div>
                </dl>
                <button class="button button-primary restart-button" data-restart>انتخاب دوباره</button>
              </section>

              <div class="step-actions">
                <button class="back-button" data-back hidden><span>→</span> قبلی</button>
                <button class="button button-primary next-button" data-next disabled>ادامه <span>←</span></button>
              </div>
            </div>

            <aside class="builder-preview">
              <div class="preview-glow"></div>
              <div class="mini-bag">
                <div class="bag-fold"></div>
                <span class="preview-brand">ORENZA</span>
                <span class="preview-sub">COFFEE ROASTERS</span>
                <div class="preview-label">
                  <span data-preview-blend>ترکیبت را انتخاب کن</span>
                  <small data-preview-roast>FRESH ROAST</small>
                </div>
                <span class="preview-weight" data-preview-weight>250 g</span>
              </div>
              <div class="preview-caption">
                <span>انتخاب زنده تو</span>
                <small>جزئیات روی پاکت تغییر می‌کند</small>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <section class="ritual-section" aria-labelledby="ritual-title">
        <p class="eyebrow">A BETTER DAILY RITUAL</p>
        <h2 id="ritual-title">هر روز، یک لحظه برای خودت.</h2>
        <div class="ritual-cards">
          <article>
            <span>01</span>
            <h3>انتخاب کن</h3>
            <p>ترکیب و رست مناسب ذائقه‌ات را پیدا کن.</p>
          </article>
          <article>
            <span>02</span>
            <h3>ما تازه آماده می‌کنیم</h3>
            <p>قهوه متناسب با دستگاه تو آسیاب و بسته‌بندی می‌شود.</p>
          </article>
          <article>
            <span>03</span>
            <h3>تو فقط دم کن</h3>
            <p>پاکت را باز کن و از عطر یک قهوه تازه لذت ببر.</p>
          </article>
        </div>
      </section>
    </main>

    <footer id="contact">
      <div class="footer-main">
        <div class="footer-brand">
          <span class="brand-mark">O</span>
          <strong>ORENZA</strong>
          <p>قهوه، آن‌طور که تو می‌پسندی.</p>
        </div>
        <div class="footer-contact">
          <span>ثبت سفارش و مشاوره</span>
          <a href="tel:+989103060396" dir="ltr">0910 306 0396</a>
          <a href="mailto:order.orenzacoffee@gmail.com">order.orenzacoffee@gmail.com</a>
        </div>
        <div class="footer-social">
          <span>ما را دنبال کن</span>
          <a href="https://instagram.com/orenzacoffee" rel="me noreferrer" target="_blank">Instagram ↗</a>
          <a href="https://t.me/orenzacoffee" rel="me noreferrer" target="_blank">Telegram ↗</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 Orenza Coffee</span>
        <span>ROASTED WITH INTENTION</span>
      </div>
    </footer>

    <script>
      import "../scripts/configurator.ts";
    </script>
  </body>
</html>
