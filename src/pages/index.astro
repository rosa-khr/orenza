---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import HomeBannerRow from "../components/HomeBannerRow.astro";
import Manifesto from "../components/Manifesto.astro";
import ProductRails from "../components/ProductRails.astro";
import AnimatedBanner from "../components/AnimatedBanner.astro";
import MobileHomeTop from "../components/MobileHomeTop.astro";
import MobileBottomNav from "../components/MobileBottomNav.astro";
import { ArrowLeft } from "@lucide/astro";
---

<BaseLayout
  title="خرید قهوه تازه رست با آسیاب دلخواه"
  description="قهوه تازه رست اورنزا را با ترکیب عربیکا و روبوستا، درجه رست و آسیاب مناسب دستگاهتان سفارش دهید؛ آماده‌سازی تازه و ارسال سراسر ایران."
  canonicalPath="/"
  keywords={["خرید قهوه تازه رست", "قهوه اسپرسو", "قهوه عربیکا", "قهوه روبوستا", "آسیاب قهوه", "قهوه اورنزا"]}
>
  <MobileHomeTop />
  <Hero />
  <Manifesto />
  <HomeBannerRow slotId="aboveDiscount" />
  <ProductRails kind="discount" />
  <section class="home-order-cta" aria-labelledby="home-order-title">
    <div>
      <span>ORENZA COFFEE ATELIER</span>
      <h2 id="home-order-title">سفارش اختصاصی قهوه</h2>
      <p>ترکیب، رُست، وزن و آسیاب را در صفحه اختصاصی انتخاب کن؛ همه چیز همان‌جا مرحله‌به‌مرحله تنظیم می‌شود.</p>
    </div>
    <a class="button button-primary" href="/order/">
      <span>شروع سفارش اختصاصی</span>
      <ArrowLeft size={18} stroke-width={1.7} aria-hidden="true" />
    </a>
  </section>
  <AnimatedBanner />
  <HomeBannerRow slotId="aboveBest" />
  <ProductRails kind="best" />
  <MobileBottomNav />
</BaseLayout>
