---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { productCategories } from "../../data/product-categories";

export function getStaticPaths() {
  return productCategories.map((category) => ({
    params: { slug: category.slug },
    props: { category }
  }));
}

const { category } = Astro.props;
const isDirectProductCategory = category.slug === "cafe-drinks" || category.slug === "herbal-tea";
---

<BaseLayout
  title={category.seoTitle}
  description={category.seoDescription}
  canonicalPath={`/category/${category.slug}/`}
  keywords={[...category.keywords]}
>
  <Breadcrumbs
    id="category"
    className="category-page-breadcrumb"
    items={[
      { label: "خانه", href: "/" },
      { label: "دسته‌بندی‌ها", href: "/categories/" },
      { label: category.title, href: `/category/${category.slug}/` }
    ]}
  />
  <section class="category-products category-subcategories" data-category-children hidden aria-labelledby="category-children-title">
    <header>
      <span>SUBCATEGORIES</span>
      <h2 id="category-children-title">زیردسته‌های این مجموعه</h2>
    </header>
    <div class="categories-tile-grid" data-category-child-list></div>
  </section>

  <section class="category-hero" data-category-hero data-category-slug={category.slug}>
    <img class="category-hero-banner" data-category-hero-banner hidden alt={`بنر ${category.title}`} />
    <div>
      <p class="eyebrow">{category.eyebrow}</p>
      <h1 data-category-title>{category.title}</h1>
      <p data-category-lead>{category.lead}</p>
      <a class="button button-primary site-outline-cta" data-category-primary-cta href={isDirectProductCategory ? "#category-products-title" : "#category-children-title"}>
        <span>{isDirectProductCategory ? "انتخاب محصول" : "انتخاب و سفارش"}</span><span aria-hidden="true">←</span>
      </a>
    </div>
  </section>

  <section class="category-products" data-category-products data-category={category.slug} aria-labelledby="category-products-title">
    <header>
      <span>AVAILABLE SELECTION</span>
      <h2 id="category-products-title">انتخاب‌های این مجموعه</h2>
    </header>
    <div data-category-product-list><p>در حال دریافت محصولات…</p></div>
  </section>

  <section class="category-editorial">
    <div class="category-admin-content" data-category-content hidden></div>
    {category.editorial ? (
      <article class="category-sales-content">
        <h2>{category.editorial.title}</h2>
        <p class="category-sales-intro">{category.editorial.intro}</p>
        {category.editorial.sections.map((section) => (
          <section>
            <h3>{section.title}</h3>
            <p>{section.body}</p>
            {section.items?.length && (
              <ul>
                {section.items.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </section>
        ))}
        <div class="category-sales-cta">
          <p>{category.editorial.closing}</p>
          {category.editorial.actions?.length ? (
            <div class="category-sales-actions">
              {category.editorial.actions.map((action) => (
                <a class:list={["category-sales-action", `is-${action.kind}`]} href={action.href} target="_blank" rel="noopener noreferrer">
                  {action.label}<span aria-hidden="true">←</span>
                </a>
              ))}
            </div>
          ) : (
            <a href="#category-products-title">مشاهده و خرید قهوه <span aria-hidden="true">←</span></a>
          )}
        </div>
      </article>
    ) : category.content.map((paragraph) => <p>{paragraph}</p>)}
  </section>
  <section class="content-tags" data-category-tags hidden>
    <header><span>RELATED TAGS</span><h2>برچسب‌های مرتبط این دسته‌بندی</h2></header>
    <div data-category-tag-list></div>
  </section>
  <script>
    import "../../scripts/category-products.ts";
  </script>
</BaseLayout>
