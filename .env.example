POSTGRES_DB=orenza
POSTGRES_USER=orenza
POSTGRES_PASSWORD=replace_with_a_long_random_password
APP_ORIGIN=https://orenza.ir
PUBLIC_SITE_URL=https://orenza.ir
ZARINPAL_MERCHANT_ID=ce8cd299-d1e0-4a87-a168-43b36bc8a624
COOKIE_SECURE=true

# Create a Web OAuth client in Google Cloud Console.
# Add https://orenza.ir to Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Password reset SMS gateway. It must accept a JSON POST containing:
# phone, code, purpose and message.
PASSWORD_RESET_SECRET=replace_with_a_long_random_secret
PASSWORD_RESET_DEBUG=false

# Kavenegar Lookup. Keep the API key only in the server environment.
KAVENEGAR_API_KEY=
KAVENEGAR_PASSWORD_TEMPLATE=password

# Optional generic webhook fallback.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Admin bootstrap. Run `npm run build --prefix backend` and then
# `npm run create-admin --prefix backend` once after deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=orenza@2026
ADMIN_NAME=مدیر اورنزا

# AI content generation. Keep the key only in the API/server environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
CONTENT_SETTINGS_SECRET=replace_with_a_long_random_secret_for_panel_stored_settings

# New-order email notification. Gmail requires 2FA and an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=order.orenzacoffee@gmail.com
SMTP_PASS=
SMTP_FROM=Orenza Orders <order.orenzacoffee@gmail.com>
ORDER_NOTIFICATION_EMAIL=order.orenzacoffee@gmail.com

# New-order Telegram notification.
# Create a bot with @BotFather, add it as a channel admin, then use @channel_username
# or the numeric channel chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=
